 <!DOCTYPE html>
<html dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مفاتيح API - J1 Studio</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .api-container { max-width: 1000px; margin: 40px auto; }
        .api-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .api-header h1 { display: flex; align-items: center; gap: 10px; color: #fff; }
        .api-header h1 i { color: #3b82f6; }
        .api-card { background: linear-gradient(135deg, #0f0f1a, #0a0a15); border: 1px solid #1a1a3a; border-radius: 16px; padding: 30px; margin-bottom: 30px; }
        .api-key-display { background: #050510; border: 1px solid #1a1a3a; border-radius: 10px; padding: 20px; display: flex; align-items: center; justify-content: space-between; margin: 20px 0; }
        .api-key-value { font-family: 'Fira Code', monospace; font-size: 18px; color: #3b82f6; letter-spacing: 1px; }
        .api-key-prefix { color: #fbbf24; font-weight: bold; }
        .api-info { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin: 20px 0; }
        .api-info-item { text-align: center; padding: 15px; background: rgba(59, 130, 246, 0.05); border-radius: 10px; }
        .api-info-item i { font-size: 24px; color: #3b82f6; margin-bottom: 10px; }
        .api-info-item h4 { color: #fff; margin-bottom: 5px; }
        .api-info-item p { color: #888; font-size: 14px; }
        .api-actions { display: flex; gap: 15px; margin-top: 20px; }
        .api-docs { background: linear-gradient(135deg, #0f0f1a, #0a0a15); border: 1px solid #1a1a3a; border-radius: 16px; padding: 30px; }
        .endpoint { display: flex; align-items: center; gap: 15px; padding: 15px; background: #050510; border-radius: 8px; margin: 10px 0; }
        .method { padding: 5px 12px; border-radius: 6px; font-weight: bold; font-size: 12px; min-width: 70px; text-align: center; }
        .method.get { background: #10b981; color: #fff; }
        .method.post { background: #3b82f6; color: #fff; }
        .method.delete { background: #ef4444; color: #fff; }
        .endpoint-url { font-family: 'Fira Code', monospace; color: #ccc; }
        .copy-notification { position: fixed; bottom: 20px; right: 20px; background: #10b981; color: #fff; padding: 12px 20px; border-radius: 10px; display: none; animation: slideIn 0.3s ease; z-index: 9999; }
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        @media (max-width: 768px) { .api-info { grid-template-columns: 1fr; } .api-actions { flex-direction: column; } .endpoint { flex-direction: column; align-items: flex-start; } .api-key-display { flex-direction: column; gap: 15px; } }
    </style>
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a href="/dashboard" class="logo">🚀 J1 Studio</a>
            <div class="nav-menu">
                <div class="user-info">
                    <% if (user.discordId) { %><img src="https://cdn.discordapp.com/avatars/<%= user.discordId %>/<%= user.discordAvatar %>.png" class="avatar"><% } %>
                    <span><%= user.username %></span>
                </div>
                <div class="coins-badge">💰 <%= user.coins %></div>
                <a href="/dashboard" class="btn btn-outline"><i class="fas fa-arrow-right"></i> لوحة التحكم</a>
            </div>
        </div>
    </nav>

    <div class="container api-container">
        <div class="api-header">
            <h1><i class="fas fa-key"></i> مفاتيح API</h1>
            <% if (!apiKey) { %>
            <button class="btn btn-primary" onclick="generateApiKey()"><i class="fas fa-plus"></i> إنشاء مفتاح جديد</button>
            <% } %>
        </div>

        <% if (apiKey) { %>
        <div class="api-card">
            <h3 style="color: #fff; margin-bottom: 15px;"><i class="fas fa-check-circle" style="color: #10b981;"></i> مفتاح API الخاص بك</h3>
            <div class="api-key-display">
                <span class="api-key-value" id="apiKeyDisplay">
                    <span class="api-key-prefix"><%= apiKeyPrefix %></span><%= apiKey.slice(apiKeyPrefix.length) %>
                </span>
                <button class="btn btn-outline" onclick="copyApiKey()"><i class="fas fa-copy"></i> نسخ</button>
            </div>
            <div class="api-info">
                <div class="api-info-item">
                    <i class="fas fa-calendar"></i>
                    <h4>تاريخ الإنشاء</h4>
                    <p><%= apiKeyCreatedAt ? new Date(apiKeyCreatedAt).toLocaleDateString('ar') : '—' %></p>
                </div>
                <div class="api-info-item">
                    <i class="fas fa-clock"></i>
                    <h4>آخر استخدام</h4>
                    <p><%= apiKeyLastUsed ? new Date(apiKeyLastUsed).toLocaleString('ar') : '—' %></p>
                </div>
                <div class="api-info-item">
                    <i class="fas fa-shield"></i>
                    <h4>الحالة</h4>
                    <p style="color: #10b981;"><i class="fas fa-circle"></i> نشط</p>
                </div>
            </div>
            <div class="api-actions">
                <button class="btn btn-warning" onclick="regenerateApiKey()"><i class="fas fa-sync-alt"></i> إعادة إنشاء</button>
                <button class="btn btn-danger" onclick="revokeApiKey()"><i class="fas fa-trash"></i> إلغاء المفتاح</button>
            </div>
        </div>
        <% } else { %>
        <div class="api-card" style="text-align: center;">
            <i class="fas fa-key" style="font-size: 64px; color: #3b82f6; margin-bottom: 20px;"></i>
            <h3 style="color: #fff; margin-bottom: 10px;">لا يوجد مفتاح API</h3>
            <p style="color: #888; margin-bottom: 20px;">أنشئ مفتاح API للوصول إلى خدماتنا برمجياً</p>
            <button class="btn btn-primary" onclick="generateApiKey()"><i class="fas fa-plus"></i> إنشاء مفتاح API</button>
        </div>
        <% } %>

        <div class="api-docs">
            <h3 style="color: #fff; margin-bottom: 20px;"><i class="fas fa-book"></i> توثيق API</h3>
            <h4 style="color: #3b82f6; margin: 20px 0 10px;">API v1</h4>
            <div class="endpoint"><span class="method get">GET</span><span class="endpoint-url">/api/v1/servers</span><span style="color: #888; margin-right: auto;">قائمة السيرفرات</span></div>
            <div class="endpoint"><span class="method get">GET</span><span class="endpoint-url">/api/v1/servers/:id</span><span style="color: #888; margin-right: auto;">معلومات سيرفر</span></div>
            <div class="endpoint"><span class="method post">POST</span><span class="endpoint-url">/api/v1/servers/:id/start</span><span style="color: #888; margin-right: auto;">تشغيل سيرفر</span></div>
            <div class="endpoint"><span class="method post">POST</span><span class="endpoint-url">/api/v1/servers/:id/stop</span><span style="color: #888; margin-right: auto;">إيقاف سيرفر</span></div>
            <div class="endpoint"><span class="method post">POST</span><span class="endpoint-url">/api/v1/servers/:id/restart</span><span style="color: #888; margin-right: auto;">إعادة تشغيل</span></div>
            <div class="endpoint"><span class="method post">POST</span><span class="endpoint-url">/api/v1/servers/:id/command</span><span style="color: #888; margin-right: auto;">إرسال أمر</span></div>
            <div class="endpoint"><span class="method get">GET</span><span class="endpoint-url">/api/v1/user</span><span style="color: #888; margin-right: auto;">معلومات المستخدم</span></div>
            
            <h4 style="color: #3b82f6; margin: 30px 0 10px;">API v2</h4>
            <div class="endpoint"><span class="method get">GET</span><span class="endpoint-url">/api/v2/servers</span><span style="color: #888; margin-right: auto;">قائمة السيرفرات</span></div>
            <div class="endpoint"><span class="method post">POST</span><span class="endpoint-url">/api/v2/servers</span><span style="color: #888; margin-right: auto;">إنشاء سيرفر</span></div>
            <div class="endpoint"><span class="method get">GET</span><span class="endpoint-url">/api/v2/servers/:id</span><span style="color: #888; margin-right: auto;">معلومات سيرفر</span></div>
            <div class="endpoint"><span class="method delete">DELETE</span><span class="endpoint-url">/api/v2/servers/:id</span><span style="color: #888; margin-right: auto;">حذف سيرفر</span></div>
            <div class="endpoint"><span class="method post">POST</span><span class="endpoint-url">/api/v2/servers/:id/start</span><span style="color: #888; margin-right: auto;">تشغيل</span></div>
            <div class="endpoint"><span class="method post">POST</span><span class="endpoint-url">/api/v2/servers/:id/stop</span><span style="color: #888; margin-right: auto;">إيقاف</span></div>
            <div class="endpoint"><span class="method post">POST</span><span class="endpoint-url">/api/v2/servers/:id/restart</span><span style="color: #888; margin-right: auto;">إعادة تشغيل</span></div>
            <div class="endpoint"><span class="method post">POST</span><span class="endpoint-url">/api/v2/servers/:id/command</span><span style="color: #888; margin-right: auto;">إرسال أمر</span></div>
            <div class="endpoint"><span class="method get">GET</span><span class="endpoint-url">/api/v2/servers/:id/logs</span><span style="color: #888; margin-right: auto;">لوجات السيرفر</span></div>
            <div class="endpoint"><span class="method get">GET</span><span class="endpoint-url">/api/v2/servers/:id/files</span><span style="color: #888; margin-right: auto;">قائمة الملفات</span></div>
            <div class="endpoint"><span class="method get">GET</span><span class="endpoint-url">/api/v2/servers/:id/files/read</span><span style="color: #888; margin-right: auto;">قراءة ملف</span></div>
            <div class="endpoint"><span class="method get">GET</span><span class="endpoint-url">/api/v2/user</span><span style="color: #888; margin-right: auto;">معلومات المستخدم</span></div>
            <div class="endpoint"><span class="method get">GET</span><span class="endpoint-url">/api/v2/stats</span><span style="color: #888; margin-right: auto;">إحصائيات</span></div>
            
            <div style="margin-top: 30px; padding: 20px; background: #050510; border-radius: 10px;">
                <h4 style="color: #fff; margin-bottom: 10px;"><i class="fas fa-code"></i> مثال للاستخدام</h4>
                <pre style="background: #000; padding: 15px; border-radius: 8px; overflow-x: auto; color: #10b981; font-family: 'Fira Code', monospace;"># استخدام API Key
curl -H "Authorization: Bearer <%= apiKey || 'mh_xxxxxxxxxxxx' %>" \
     https://J1-studio.com/api/v2/servers

# أو باستخدام x-api-key
curl -H "x-api-key: <%= apiKey || 'mh_xxxxxxxxxxxx' %>" \
     https://J1-studio.com/api/v1/servers

# إنشاء سيرفر
curl -X POST \
     -H "Authorization: Bearer <%= apiKey || 'mh_xxxxxxxxxxxx' %>" \
     -H "Content-Type: application/json" \
     -d '{"name":"My Bot","mainFile":"index.js"}' \
     https://J1-studio.com/api/v2/servers

# تشغيل سيرفر
curl -X POST \
     -H "Authorization: Bearer <%= apiKey || 'mh_xxxxxxxxxxxx' %>" \
     https://J1-studio.com/api/v2/servers/SERVER_ID/start</pre>
            </div>
        </div>
    </div>

    <div class="copy-notification" id="copyNotification"><i class="fas fa-check"></i> تم نسخ المفتاح</div>

    <script>
        async function generateApiKey() {
            if (!confirm('إنشاء مفتاح API جديد؟')) return;
            try {
                const res = await fetch('/api/keys/generate', { method: 'POST' });
                const data = await res.json();
                if (data.success) location.reload();
                else alert(data.error);
            } catch (err) { alert('حدث خطأ'); }
        }
        async function regenerateApiKey() {
            if (!confirm('إعادة إنشاء المفتاح؟ المفتاح القديم سيتوقف عن العمل.')) return;
            await generateApiKey();
        }
        async function revokeApiKey() {
            if (!confirm('إلغاء مفتاح API؟ لن تتمكن من استخدام API بعد الآن.')) return;
            try {
                const res = await fetch('/api/keys/revoke', { method: 'POST' });
                const data = await res.json();
                if (data.success) location.reload();
                else alert(data.error);
            } catch (err) { alert('حدث خطأ'); }
        }
        function copyApiKey() {
            const apiKey = '<%= apiKey %>';
            navigator.clipboard.writeText(apiKey).then(() => {
                const notification = document.getElementById('copyNotification');
                notification.style.display = 'block';
                setTimeout(() => notification.style.display = 'none', 2000);
            });
        }
    </script>
</body>
</html>