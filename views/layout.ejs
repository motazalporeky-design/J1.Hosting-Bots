<!DOCTYPE html>
<html dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'J1 Studio' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🚀</text></svg>">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <a href="/dashboard" class="logo">🚀 J1 Studio</a>
            <% if (typeof user !== 'undefined' && user) { %>
            <div class="nav-menu">
                <div class="user-info">
                    <% if (user.discordId) { %>
                    <img src="https://cdn.discordapp.com/avatars/<%= user.discordId %>/<%= user.discordAvatar %>.png" class="avatar" onerror="this.src='https://ui-avatars.com/api/?name=' + encodeURIComponent('<%= user.username %>') + '&background=3b82f6&color=fff'">
                    <% } else { %>
                    <img src="https://ui-avatars.com/api/?name=<%= encodeURIComponent(user.username) %>&background=3b82f6&color=fff" class="avatar">
                    <% } %>
                    <span><%= user.username %></span>
                </div>
                <div class="coins-badge">
                    <span>💰</span> <%= user.coins %>
                </div>
                <% if (user.isOwner) { %>
                <a href="/admin" class="btn btn-warning">👑 لوحة المالك</a>
                <% } %>
                <a href="/logout" class="btn btn-outline">🚪 خروج</a>
            </div>
            <% } %>
        </div>
    </nav>
    
    <main>
        <%- body %>
    </main>
    
    <script src="/socket.io/socket.io.js"></script>
</body>
</html>