   FILE MANAGER
========================================================= */

async function refreshFiles() {

    if (!serverPermissions.files) {

        showToast(
            'ليس لديك صلاحية الوصول إلى الملفات.',
            'error'
        );

        return;

    }

    try {

        const r =
            await fetch(
                `/servers/${serverId}/files?dir=${encodeURIComponent(currentPath)}`
            );

        const d =
            await r.json();

        let html = '';

        if (currentPath) {

            const parent =
                currentPath
                    .split('/')
                    .slice(0,-1)
                    .join('/');

            html += `

                <tr>

                    <td colspan="5">

                        <a
                            href="#"
                            onclick="navigateTo('${parent}');return false;"
                            style="
                                color:#818cf8;
                                text-decoration:none;
                            "
                        >

                            <i class="fas fa-arrow-up"></i>
                            الرجوع

                        </a>

                    </td>

                </tr>

            `;

        }

        (d.files || []).forEach(f => {

            const icon =
                getFileIcon(
                    f.name,
                    f.isDirectory
                );

            const size =
                f.isDirectory
                    ? '—'
                    : formatSize(f.size);

            const menuId =
                'menu-' +
                btoa(
                    unescape(
                        encodeURIComponent(f.path)
                    )
                )
                .replace(/[^a-zA-Z0-9]/g,'_');

            html += `

                <tr>

                    <td>

                        <input
                            type="checkbox"
                            class="file-checkbox"
                            value="${escapeHtml(f.path)}"
                            onchange="updateSelection()"
                        >

                    </td>

                    <td>

                        <span
                            class="file-name"
                            onclick="${
                                f.isDirectory
                                ? `navigateTo('${escapeJs(f.path)}')`
                                : `editFile('${escapeJs(f.path)}')`
                            }"
                        >

                            ${icon}

                            ${escapeHtml(f.name)}

                        </span>

                    </td>

                    <td>
                        ${size}
                    </td>

                    <td>
                        ${
                            f.modified
                            ? new Date(
                                f.modified
                              ).toLocaleString('ar')
                            : '—'
                        }
                    </td>

                    <td>

                        <div class="file-actions-menu">

                            <button
                                class="menu-dots"
                                onclick="toggleMenu(event,'${escapeJs(menuId)}')"
                            >
                                <i class="fas fa-ellipsis"></i>
                            </button>

                            <div
                                class="menu-dropdown"
                                id="${menuId}"
                            >

                                <div
                                    class="menu-item"
                                    onclick="editFile('${escapeJs(f.path)}')"
                                >
                                    <i class="fas fa-pen-to-square"></i>
                                    تحرير
                                </div>

                                <div
                                    class="menu-item"
                                    onclick="downloadFile('${escapeJs(f.path)}')"
                                >
                                    <i class="fas fa-cloud-arrow-down"></i>
                                    تحميل
                                </div>

                                <div
                                    class="menu-item"
                                    onclick="showRenameModal('${escapeJs(f.path)}','${escapeJs(f.name)}')"
                                >
                                    <i class="fas fa-signature"></i>
                                    إعادة تسمية
                                </div>

                                <div
                                    class="menu-item danger"
                                    onclick="deleteFile('${escapeJs(f.path)}')"
                                >
                                    <i class="fas fa-trash-can"></i>
                                    حذف
                                </div>

                            </div>

                        </div>

                    </td>

                </tr>

            `;

        });

        document.getElementById(
            'fileList'
        ).innerHTML =
            html ||

            `

                <tr>

                    <td
                        colspan="5"
                        style="
                            padding:40px;
                            text-align:center;
                            color:#667085;
                        "
                    >

                        <i
                            class="fas fa-folder-open"
                            style="
                                display:block;
                                font-size:30px;
                                margin-bottom:10px;
                            "
                        ></i>

                        المجلد فارغ

                    </td>

                </tr>

            `;

        updateBreadcrumb();

        selectedPaths = [];

        document.getElementById(
            'selectAllFiles'
        ).checked = false;

        updateSelection();

    } catch (err) {

        document.getElementById(
            'fileList'
        ).innerHTML = `

            <tr>

                <td
                    colspan="5"
                    style="
                        text-align:center;
                        padding:35px;
                        color:#fb7185;
                    "
                >

                    <i class="fas fa-circle-xmark"></i>

                    فشل تحميل الملفات

                </td>

            </tr>

        `;

    }

}

function escapeJs(text) {

    return String(text)
        .replace(/\\/g,'\\\\')
        .replace(/'/g,"\\'")
        .replace(/\n/g,'\\n')
        .replace(/\r/g,'\\r');

}

function toggleMenu(event, id) {

    event.stopPropagation();

    document.querySelectorAll(
        '.menu-dropdown'
    ).forEach(m =>
        m.classList.remove('active')
    );

    const menu =
        document.getElementById(id);

    if (menu)
        menu.classList.add('active');

}

document.addEventListener(
    'click',
    () => {

        document.querySelectorAll(
            '.menu-dropdown'
        ).forEach(m =>
            m.classList.remove('active')
        );

    }
);

function getFileIcon(name, isDir) {

    if (isDir)
        return '<i class="fas fa-folder"></i>';

    const ext =
        name
            .split('.')
            .pop()
            .toLowerCase();

    const icons = {

        js:
            '<i class="fab fa-js"></i>',

        json:
            '<i class="fas fa-code"></i>',

        html:
            '<i class="fab fa-html5"></i>',

        css:
            '<i class="fab fa-css3-alt"></i>',

        md:
            '<i class="fab fa-markdown"></i>',

        py:
            '<i class="fab fa-python"></i>',

        php:
            '<i class="fab fa-php"></i>',

        sh:
            '<i class="fas fa-terminal"></i>',

        txt:
            '<i class="fas fa-file-lines"></i>',

        env:
            '<i class="fas fa-key"></i>',

        zip:
            '<i class="fas fa-file-zipper"></i>',

        rar:
            '<i class="fas fa-file-zipper"></i>',

        tar:
            '<i class="fas fa-file-zipper"></i>'

    };

    return (
        icons[ext] ||
        '<i class="fas fa-file"></i>'
    );

}

function formatSize(bytes) {

    if (!bytes)
        return '0 B';

    if (bytes < 1024)
        return bytes + ' B';

    if (bytes < 1048576)
        return (
            bytes / 1024
        ).toFixed(2) + ' KB';

    if (bytes < 1073741824)
        return (
            bytes / 1048576
        ).toFixed(2) + ' MB';

    return (
        bytes / 1073741824
    ).toFixed(2) + ' GB';

}

function navigateTo(path) {

    currentPath = path || '';

    refreshFiles();

}

function updateBreadcrumb() {

    const parts =
        currentPath
            .split('/')
            .filter(Boolean);

    let html = `

        <a
            href="#"
            onclick="navigateTo('');return false;"
        >
            <i class="fas fa-house"></i>
            الرئيسية
        </a>

    `;

    let build = '';

    parts.forEach(p => {

        build +=
            (build ? '/' : '') + p;

        html += `

            <span style="color:#475166;">
                /
            </span>

            <a
                href="#"
                onclick="navigateTo('${escapeJs(build)}');return false;"
            >
                ${escapeHtml(p)}
            </a>

        `;

    });

    document.getElementById(
        'breadcrumb'
    ).innerHTML = html;

}

/* =========================================================
   EDITOR
========================================================= */

function getLanguage(filename) {

    const ext =
        filename
            .split('.')
            .pop()
            .toLowerCase();

    const langs = {

        js: 'javascript',
        json: 'javascript',
        html: 'htmlmixed',
        css: 'css',
        md: 'markdown',
        py: 'python',
        php: 'php',
        sh: 'shell',
        yml: 'yaml',
        yaml: 'yaml'

    };

    return (
        langs[ext] ||
        'javascript'
    );

}

async function editFile(path) {

    if (!serverPermissions.fileEdit) {

        showToast(
            'ليس لديك صلاحية تعديل الملفات.',
            'error'
        );

        return;

    }

    try {

        const r =
            await fetch(
                `/servers/${serverId}/files/read?file=${encodeURIComponent(path)}`
            );

        const d =
            await r.json();

        if (d.error) {

            showToast(
                d.error,
                'error'
            );

            return;

        }

        currentFile = path;

        const lang =
            getLanguage(path);

        const langNames = {

            javascript: 'JavaScript',
            htmlmixed: 'HTML',
            css: 'CSS',
            markdown: 'Markdown',
            python: 'Python',
            php: 'PHP',
            shell: 'Shell',
            yaml: 'YAML'

        };

        document.getElementById(
            'editorIcon'
        ).className =
            getFileIcon(
                path,
                false
            )
            .match(
                /(?:fas|fab)\s+fa-[a-z0-9-]+/
            )?.[0]
            ||
            'fas fa-file-code';

        document.getElementById(
            'editorTitle'
        ).textContent = path;

        document.getElementById(
            'editorLang'
        ).textContent =
            langNames[lang] || lang;

        document.getElementById(
            'editorModal'
        ).classList.add('active');

        setTimeout(() => {

            if (editor) {

                editor.toTextArea();

                editor = null;

            }

            editor =
                CodeMirror.fromTextArea(
                    document.getElementById(
                        'editor'
                    ),
                    {

                        mode: lang,

                        theme: 'dracula',

                        lineNumbers: true,

                        matchBrackets: true,

                        autoCloseBrackets: true,

                        autoCloseTags: true,

                        foldGutter: true,

                        gutters: [
                            'CodeMirror-linenumbers',
                            'CodeMirror-foldgutter'
                        ],

                        extraKeys: {

                            'Ctrl-S':
                                saveFileFromEditor,

                            'Cmd-S':
                                saveFileFromEditor

                        },

                        lineWrapping: true,

                        styleActiveLine: true,

                        indentUnit: 2,

                        tabSize: 2

                    }
                );

            editor.setValue(
                d.content || ''
            );

            editor.refresh();

            editor.on(
                'cursorActivity',
                () => {

                    const pos =
                        editor.getCursor();

                    document.getElementById(
                        'editorCursor'
                    ).textContent =
                        `Ln ${pos.line + 1}, Col ${pos.ch + 1}`;

                    document.getElementById(
                        'editorSize'
                    ).textContent =
                        `${editor.lineCount()} lines`;

                }
            );

            editor.focus();

        },100);

    } catch (err) {

        showToast(
            'فشل فتح الملف.',
            'error'
        );

    }

}

async function saveFileFromEditor() {

    if (!editor)
        return;

    try {

        const r =
            await fetch(
                `/servers/${serverId}/files/save`,
                {
                    method: 'POST',

                    headers: {
                        'Content-Type':
                            'application/json'
                    },

                    body:
                        JSON.stringify({
                            file: currentFile,
                            content:
                                editor.getValue()
                        })

                }
            );

        const d =
            await r.json();

        if (d.success === false) {

            showToast(
                d.error || 'فشل حفظ الملف.',
                'error'
            );

            return;

        }

        showToast(
            'تم حفظ الملف بنجاح.',
            'success'
        );

        closeModal('editorModal');

        refreshFiles();

    } catch (err) {

        showToast(
            'فشل حفظ الملف.',
            'error'
        );

    }

}

