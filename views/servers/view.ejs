                                title="إزالة"
                            >
                                <i class="fas fa-user-minus"></i>
                            </button>

                        </td>

                    </tr>

                `;

            }).join('');

        list.innerHTML =
            ownerRow +
            collaborators;

    } catch (err) {

        console.warn(
            'Users endpoint unavailable',
            err
        );

    }

}


