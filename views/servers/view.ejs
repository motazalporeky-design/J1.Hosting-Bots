   SETTINGS
========================================================= */

async function saveSettings() {

    if (!serverPermissions.settings) {

        showToast(
            'ليس لديك صلاحية تعديل إعدادات السيرفر.',
            'error'
        );

        return;

    }

    try {

        const mainFile =
            document.getElementById(
                'mainFile'
            ).value.trim();

        const nodeVersion =
            document.getElementById(
                'nodeVersion'
            ).value;

        const envText =
            document.getElementById(
                'envVariables'
            ).value;

        const envVars = {};

        envText
            .split('\n')
            .forEach(line => {

                const index =
                    line.indexOf('=');

                if (index === -1)
                    return;

                const key =
                    line.slice(0,index).trim();

                const value =
                    line.slice(index + 1).trim();

                if (key)
                    envVars[key] = value;

            });

        const r =
            await fetch(
                `/servers/${serverId}/settings`,
                {
                    method: 'POST',
                    headers: {
                        'Content-Type':
                            'application/json'
                    },
                    body:
                        JSON.stringify({
                            mainFile,
                            nodeVersion,
                            envVariables: envVars
                        })
                }
            );

        const d =
            await r.json();

        if (d.success) {

            showToast(
                'تم حفظ إعدادات السيرفر بنجاح.',
                'success'
            );

        } else {

            showToast(
                d.error || 'فشل حفظ الإعدادات.',
                'error'
            );

        }

    } catch (err) {

        showToast(
            'حدث خطأ أثناء حفظ الإعدادات.',
            'error'
        );

    }

}

