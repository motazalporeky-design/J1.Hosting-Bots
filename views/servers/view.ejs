/* =========================================================
   COLLABORATOR PERMISSIONS
========================================================= */

function editCollaboratorPermissions(userId) {

    if (!isServerOwner) {

        showToast(
            'فقط صاحب السيرفر يستطيع تعديل الصلاحيات.',
            'error'
        );

        return;
    }

    const permissions = [

        {
            key: 'view',
            name: 'مشاهدة السيرفر'
        },

        {
            key: 'start',
            name: 'تشغيل السيرفر'
        },

        {
            key: 'stop',
            name: 'إيقاف السيرفر'
        },

        {
            key: 'restart',
            name: 'إعادة تشغيل السيرفر'
        },

        {
            key: 'console',
            name: 'مشاهدة Console'
        },

        {
            key: 'consoleCommand',
            name: 'إرسال أوامر Console'
        },

        {
            key: 'files',
            name: 'الوصول للملفات'
        },

        {
            key: 'fileEdit',
            name: 'تعديل الملفات'
        },

        {
            key: 'upload',
            name: 'رفع الملفات'
        },

        {
            key: 'deleteFiles',
            name: 'حذف الملفات'
        },

        {
            key: 'packages',
            name: 'إدارة Packages'
        },

        {
            key: 'settings',
            name: 'إعدادات السيرفر'
        }

    ];

    const current = prompt(
        'اكتب الصلاحيات المطلوبة مفصولة بفاصلة:\n\n' +

        permissions
            .map(p => `${p.key} = ${p.name}`)
            .join('\n') +

        '\n\nمثال:\nview,start,console,files'
    );

    if (current === null) {
        return;
    }

    const selected = current
        .split(',')
        .map(x => x.trim())
        .filter(Boolean);

    const permissionData = {};

    permissions.forEach(permission => {

        permissionData[permission.key] =
            selected.includes(permission.key);

    });

    // المتعاون يجب أن يستطيع مشاهدة السيرفر دائمًا
    permissionData.view = true;

    fetch(
        `/servers/${serverId}/collaborators/permissions`,
        {
            method: 'POST',

            headers: {
                'Content-Type': 'application/json'
            },

            body: JSON.stringify({
                userId,
                permissions: permissionData
            })
        }
    )
    .then(async r => {

        const data = await r.json();

        if (!r.ok || !data.success) {

            throw new Error(
                data.error ||
                'فشل تحديث الصلاحيات'
            );
        }

        showToast(
            'تم تحديث صلاحيات المتعاون.',
            'success'
        );

        refreshServerUsers();

    })
    .catch(err => {

        showToast(
            err.message ||
            'فشل تحديث الصلاحيات.',
            'error'
        );

    });

}
