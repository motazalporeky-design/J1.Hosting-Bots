async function createFile() {

    if (!serverPermissions.fileEdit) {

        showToast(
            'ليس لديك صلاحية إنشاء الملفات.',
            'error'
        );

        return;

    }

    const name =
        document.getElementById(
            'newFileName'
        ).value.trim();

    if (!name) {

        showToast(
            'أدخل اسم الملف.',
            'warning'
        );

        return;

    }

    try {

        await fetch(
            `/servers/${serverId}/files/create`,
            {
                method: 'POST',

                headers: {
                    'Content-Type':
                        'application/json'
                },

                body:
                    JSON.stringify({

                        path:
                            currentPath
                            ? currentPath + '/' + name
                            : name,

                        type: 'file',

                        content: ''

                    })

            }
        );

        closeModal(
            'createFileModal'
        );

        showToast(
            'تم إنشاء الملف.',
            'success'
        );

        refreshFiles();

    } catch (err) {

        showToast(
            'فشل إنشاء الملف.',
            'error'
        );

    }

}

async function createFolder() {

    if (!serverPermissions.fileEdit) {

        showToast(
            'ليس لديك صلاحية إنشاء المجلدات.',
            'error'
        );

        return;

    }

    const name =
        document.getElementById(
            'newFolderName'
        ).value.trim();

    if (!name) {

        showToast(
            'أدخل اسم المجلد.',
            'warning'
        );

        return;

    }

    try {

        await fetch(
            `/servers/${serverId}/files/create`,
            {
                method: 'POST',

                headers: {
                    'Content-Type':
                        'application/json'
                },

                body:
                    JSON.stringify({

                        path:
                            currentPath
                            ? currentPath + '/' + name
                            : name,

                        type: 'folder'

                    })

            }
        );

        closeModal(
            'createFolderModal'
        );

        showToast(
            'تم إنشاء المجلد.',
            'success'
        );

        refreshFiles();

    } catch (err) {

        showToast(
            'فشل إنشاء المجلد.',
            'error'
        );

    }

}

/* =========================================================
   DELETE / RENAME / DOWNLOAD
========================================================= */

async function deleteFile(path) {

    if (!serverPermissions.deleteFiles) {

        showToast(
            'ليس لديك صلاحية حذف الملفات.',
            'error'
        );

        return;

    }

    if (!confirm(
        'هل تريد حذف هذا العنصر؟'
    ))
        return;

    try {

        await fetch(
            `/servers/${serverId}/files/delete`,
            {
                method: 'POST',

                headers: {
                    'Content-Type':
                        'application/json'
                },

                body:
                    JSON.stringify({ path })

            }
        );

        showToast(
            'تم حذف العنصر.',
            'success'
        );

        refreshFiles();

    } catch (err) {

        showToast(
            'فشل حذف العنصر.',
            'error'
        );

    }

}

function showRenameModal(path,name) {

    if (!serverPermissions.fileEdit) {

        showToast(
            'ليس لديك صلاحية إعادة تسمية الملفات.',
            'error'
        );

        return;

    }

    document.getElementById(
        'renameOldPath'
    ).value = path;

    document.getElementById(
        'renameNewName'
    ).value = name;

    document.getElementById(
        'renameModal'
    ).classList.add('active');

}

async function renameFile() {

    if (!serverPermissions.fileEdit) {

        showToast(
            'ليس لديك صلاحية إعادة تسمية الملفات.',
            'error'
        );

        return;

    }

    const old =
        document.getElementById(
            'renameOldPath'
        ).value;

    const name =
        document.getElementById(
            'renameNewName'
        ).value.trim();

    if (!name) {

        showToast(
            'أدخل الاسم الجديد.',
            'warning'
        );

        return;

    }

    try {

        await fetch(
            `/servers/${serverId}/files/rename`,
            {
                method: 'POST',

                headers: {
                    'Content-Type':
                        'application/json'
                },

                body:
                    JSON.stringify({
                        oldPath: old,
                        newName: name
                    })

            }
        );

        closeModal(
            'renameModal'
        );

        showToast(
            'تمت إعادة التسمية.',
            'success'
        );

        refreshFiles();

    } catch (err) {

        showToast(
            'فشلت إعادة التسمية.',
            'error'
        );

    }

}

function downloadFile(path) {

    window.open(
        `/servers/${serverId}/files/read?file=${encodeURIComponent(path)}&download=true`,
        '_blank'
    );

}

/* =========================================================
   MODALS
========================================================= */

function showUploadModal() {

    if (!serverPermissions.upload) {

        showToast(
            'ليس لديك صلاحية رفع الملفات.',
            'error'
        );

        return;

    }

    document.getElementById(
        'uploadModal'
    ).classList.add('active');

    selectedFiles = [];

    document.getElementById(
        'selectedFiles'
    ).innerHTML = '';

}

function showCreateFileModal() {

    document.getElementById(
        'createFileModal'
    ).classList.add('active');

    document.getElementById(
        'newFileName'
    ).value = '';

}

function showCreateFolderModal() {

    document.getElementById(
        'createFolderModal'
    ).classList.add('active');

    document.getElementById(
        'newFolderName'
    ).value = '';

}

function closeModal(id) {

    const modal =
        document.getElementById(id);

    if (!modal)
        return;

    modal.classList.remove('active');

    if (
        id === 'editorModal' &&
        editor
    ) {

        editor.toTextArea();

        editor = null;

    }

}

/* =========================================================
   UPLOAD
========================================================= */

function renderSelectedFiles() {

    document.getElementById(
        'selectedFiles'
    ).innerHTML =
        selectedFiles
            .map(f => `

                <div
                    style="
                        display:flex;
                        align-items:center;
                        gap:8px;
                        padding:6px 0;
                        color:#cbd5e1;
                        font-size:11px;
                    "
                >

                    ${getFileIcon(f.name,false)}

                    <span>
                        ${escapeHtml(f.name)}
                    </span>

                </div>

            `)
            .join('');

}

document.getElementById(
    'dropZone'
).onclick = () =>
    document.getElementById(
        'fileInput'
    ).click();

document.getElementById(
    'dropZone'
).ondragover = e => {

    e.preventDefault();

    e.currentTarget.style.borderColor =
        'rgba(99,102,241,.7)';

};

document.getElementById(
    'dropZone'
).ondragleave = e => {

    e.currentTarget.style.borderColor =
        '';

};

document.getElementById(
    'dropZone'
).ondrop = e => {

    e.preventDefault();

    selectedFiles =
        Array.from(
            e.dataTransfer.files
        );

    renderSelectedFiles();

};

document.getElementById(
    'fileInput'
).onchange = e => {

    selectedFiles =
        Array.from(
            e.target.files
        );

    renderSelectedFiles();

};

async function uploadFiles() {

    if (!serverPermissions.upload) {

        showToast(
            'ليس لديك صلاحية رفع الملفات.',
            'error'
        );

        return;

    }

    if (!selectedFiles.length) {

        showToast(
            'اختر ملفات أولاً.',
            'warning'
        );

        return;

    }

    try {

        const form =
            new FormData();

        selectedFiles.forEach(
            f =>
                form.append(
                    'files',
                    f
                )
        );

        form.append(
            'dir',
            currentPath
        );

        form.append(
            'extract',
            document.getElementById(
                'extractArchive'
            ).checked
        );

        const res =
            await fetch(
                `/servers/${serverId}/files/upload`,
                {
                    method: 'POST',
                    body: form
                }
            );

        const data =
            await res.json()
                .catch(() => ({}));

        if (data.success === false) {

            showToast(
                data.error || 'فشل رفع الملفات.',
                'error'
            );

            return;

        }

        closeModal(
            'uploadModal'
        );

        showToast(
            'تم رفع الملفات بنجاح.',
            'success'
        );

        refreshFiles();

    } catch (err) {

        showToast(
            'فشل رفع الملفات.',
            'error'
        );

    }

}

/* =========================================================
   PACKAGES
========================================================= */

function showPackagesModal() {

    if (!serverPermissions.packages) {

        showToast(
            'ليس لديك صلاحية إدارة Packages.',
            'error'
        );

        return;

    }

    document.getElementById(
        'packagesModal'
    ).classList.add('active');

}

function downloadPackage() {

    if (!serverPermissions.packages) {

        showToast(
            'ليس لديك صلاحية إدارة Packages.',
            'error'
        );

        return;

    }

    const selected =
        document.getElementById(
            'packageSelect'
        ).value;

    const custom =
        document.getElementById(
            'customPackage'
        ).value.trim();

    const packageName =
        custom || selected;

    if (!packageName) {

        showToast(
            'اختر أو اكتب اسم البكج.',
            'warning'
        );

        return;

    }

    showToast(
        `جاري تنزيل ${packageName}...`,
        'info'
    );

    window.location.href =
        `/servers/${serverId}/packages/download?name=${encodeURIComponent(packageName)}`;

}

/* =========================================================
   FILE SELECTION
========================================================= */

function updateSelection() {

    selectedPaths = [];

    document
        .querySelectorAll(
            '.file-checkbox:checked'
        )
        .forEach(cb => {

            selectedPaths.push(
                cb.value
            );

        });

    document.getElementById(
        'selectedCount'
    ).textContent =
        `${selectedPaths.length} محدد`;

    document.getElementById(
        'bulkActions'
    ).style.display =
        selectedPaths.length
            ? 'flex'
            : 'none';

}

function toggleSelectAll(el) {

    document
        .querySelectorAll(
            '.file-checkbox'
        )
        .forEach(cb => {

            cb.checked =
                el.checked;

        });

    updateSelection();

}

async function deleteSelected() {

    if (!serverPermissions.deleteFiles) {

        showToast(
            'ليس لديك صلاحية حذف الملفات.',
            'error'
        );

        return;

    }

    if (!selectedPaths.length)
        return;

    if (!confirm(
        `حذف ${selectedPaths.length} عنصر؟`
    ))
        return;

    try {

        for (const path of selectedPaths) {

            await fetch(
                `/servers/${serverId}/files/delete`,
                {
                    method: 'POST',

                    headers: {
                        'Content-Type':
                            'application/json'
                    },

                    body:
                        JSON.stringify({
                            path
                        })

                }
            );

        }

        showToast(
            'تم حذف العناصر المحددة.',
            'success'
        );

        selectedPaths = [];

        refreshFiles();

    } catch (err) {

        showToast(
            'حدث خطأ أثناء الحذف.',
            'error'
        );

    }

}

async function archiveSelected() {

    if (!serverPermissions.fileEdit) {

        showToast(
            'ليس لديك صلاحية ضغط الملفات.',
            'error'
        );

        return;

    }

    if (!selectedPaths.length)
        return;

    const name =
        prompt(
            'اسم الأرشيف:',
            'archive.zip'
        );

    if (!name)
        return;

    try {

        const res =
            await fetch(
                `/servers/${serverId}/files/archive`,
                {
                    method: 'POST',

                    headers: {
                        'Content-Type':
                            'application/json'
                    },

                    body:
                        JSON.stringify({

                            paths:
                                selectedPaths,

                            archiveName:
                                name

                        })

                }
            );

        const data =
            await res.json();

        if (data.success) {

            showToast(
                'تم إنشاء الأرشيف بنجاح.',
                'success'
            );

            refreshFiles();

        } else {

            showToast(
                data.error ||
                'فشل إنشاء الأرشيف.',
                'error'
            );

        }

    } catch (err) {

        showToast(
            'فشل إنشاء الأرشيف.',
            'error'
        );

    }

}

/* =========================================================
   KEYBOARD
========================================================= */

document.addEventListener(
    'keydown',
    e => {

        if (e.key === 'Escape') {

            document
                .querySelectorAll(
                    '.modal-overlay'
                )
                .forEach(m =>
                    m.classList.remove(
                        'active'
                    )
                );

        }

    }
);

/* =========================================================
   INIT
========================================================= */

refreshFiles();

</script>

</body>
</html>