========================================================= */

#bulkActions {
    background: rgba(255,255,255,.025) !important;
    border-color: rgba(255,255,255,.07) !important;
}


/* =========================================================
   MODALS
========================================================= */

.modal-overlay {
    background: rgba(0,0,0,.82) !important;
}

.modal-box {
    background:
        linear-gradient(
            145deg,
            #171717,
            #080808
        ) !important;

    border-color: rgba(255,255,255,.09) !important;
}

.modal-header h2 {
    color: #ffffff !important;
}

.modal-header h2 i {
    color: #cccccc !important;
}

.editor-container {
    border-color: rgba(255,255,255,.08) !important;
}

.upload-area {
    border-color: rgba(255,255,255,.16) !important;
    background: rgba(255,255,255,.02) !important;
    color: #999999 !important;
}

.upload-area i {
    color: #dddddd !important;
}

.upload-area:hover {
    border-color: rgba(255,255,255,.35) !important;
    background: rgba(255,255,255,.04) !important;
}


/* =========================================================
   FORMS
========================================================= */

.auth-box {
    background: rgba(15,15,15,.92) !important;
    border-color: rgba(255,255,255,.08) !important;
}

.form-group label {
    color: #cccccc !important;
}

.form-group input,
.form-group select,
.form-group textarea,
.modal-box input,
.modal-box select {
    background: #080808 !important;
    border-color: rgba(255,255,255,.08) !important;
    color: #ffffff !important;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus,
.modal-box input:focus,
.modal-box select:focus {
    border-color: rgba(255,255,255,.28) !important;

    box-shadow:
        0 0 0 3px rgba(255,255,255,.035) !important;
}


/* =========================================================
   CODEMIRROR
========================================================= */

.CodeMirror,
.cm-s-dracula.CodeMirror {
    background: #090909 !important;
    color: #f5f5f5 !important;
}

.cm-s-dracula .CodeMirror-gutters {
    background: #070707 !important;
    border-right: 1px solid #202020 !important;
}

.cm-s-dracula .CodeMirror-linenumber {
    color: #555555 !important;
}

.cm-s-dracula .CodeMirror-cursor {
    border-left-color: #ffffff !important;
}

.cm-s-dracula .CodeMirror-selected {
    background: rgba(255,255,255,.12) !important;
}


/* =========================================================
   TOAST
========================================================= */

.premium-toast {
    background:
        linear-gradient(
            135deg,
            rgba(25,25,25,.98),
            rgba(8,8,8,.98)
        ) !important;

    border-color: rgba(255,255,255,.08) !important;
}

.toast-icon {
    background: rgba(255,255,255,.06) !important;
    color: #dddddd !important;
}

.premium-toast.success .toast-icon {
    background: rgba(255,255,255,.06) !important;
    color: #eeeeee !important;
}

.premium-toast.warning .toast-icon {
    background: rgba(255,255,255,.06) !important;
    color: #dddddd !important;
}

.toast-title {
    color: #ffffff !important;
}

.toast-message {
    color: #888888 !important;
}


/* =========================================================
   DANGER — يبقى أحمر حتى يكون واضحًا
========================================================= */

.btn-danger {
    background:
        linear-gradient(
            135deg,
            #b91c1c,
            #ef4444
        ) !important;

    border-color: rgba(239,68,68,.25) !important;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 768px) {

    .server-header-detail {
        background:
            linear-gradient(
                145deg,
                rgba(28,28,28,.97),
                rgba(9,9,9,.99)
            ) !important;
    }

}


</style>

</head>

<body>

<!-- =========================================================
     TOAST CONTAINER
========================================================= -->

<div id="toastContainer"></div>

<!-- =========================================================
     NAVBAR
========================================================= -->

<nav class="navbar">
    <div class="container">

    <a href="/dashboard" class="logo">
        J1 Studio
    </a>

    <div class="nav-menu">

        <div class="user-info">

            <% if (user.discordId) { %>
                <img
                    src="https://cdn.discordapp.com/avatars/<%= user.discordId %>/<%= user.discordAvatar %>.png"
                    class="avatar"
                    onerror="this.style.display='none'"
                >
            <% } %>

            <span><%= user.username %></span>

        </div>

        <div class="coins-badge">
            <%= user.coins %>
        </div>

        <a href="/dashboard" class="btn btn-outline btn-sm" title="العودة">

            <i class="fas fa-arrow-right"></i>

        </a>

    </div>

</div>

</nav>

<!-- =========================================================
     MAIN
========================================================= -->

<div class="container">

<!-- SERVER HEADER -->

<div class="server-header-detail">

    <h1>

        <span id="serverName">
            <%= server.name %>
        </span>

        <button
            class="btn btn-sm btn-outline"
            onclick="editName()"
            title="تعديل اسم السيرفر"
        >
            <i class="fas fa-pen"></i>
        </button>

    </h1>

    <span
        class="server-status status-<%= server.status %>"
        id="serverStatus"
    >
        <%= server.status === 'running' ? 'يعمل' : 'متوقف' %>
    </span>

</div>

<!-- =====================================================
     STATISTICS
===================================================== -->

<div class="stats-grid">

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fas fa-microchip"></i>
        </div>

        <div class="stat-content">

            <h3 id="cpuPercent">
                0%
            </h3>

            <p>CPU Usage</p>

        </div>

    </div>

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fas fa-globe"></i>
        </div>

        <div class="stat-content">

            <h3
                id="serverAddress"
                style="font-size:13px;word-break:break-all;"
            >
                http://J1.hosting:<%=portRange%>
            </h3>

            <p>Server Address</p>

        </div>

    </div>

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fas fa-memory"></i>
        </div>

        <div class="stat-content">

            <h3 id="ramPercent">
                0%
            </h3>

            <p>RAM Usage</p>

        </div>

    </div>

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fas fa-hard-drive"></i>
        </div>

        <div class="stat-content">

            <h3 id="diskPercent">
                0%
            </h3>

            <p>Disk Usage</p>

        </div>

    </div>

    <div class="stat-card">

        <div class="stat-icon">
            <i class="fas fa-stopwatch"></i>
        </div>

        <div class="stat-content">

            <h3 id="uptime">
                —
            </h3>

            <p>Uptime</p>

        </div>

    </div>

</div>

<!-- =====================================================
     TABS
===================================================== -->

<div class="server-tabs">

    <button
        class="tab-btn active"
        onclick="switchTab('console', this)"
    >
        <i class="fas fa-terminal"></i>
        الكونسول
    </button>

    <button
        class="tab-btn"
        onclick="switchTab('files', this)"
    >
        <i class="fas fa-folder-tree"></i>
        الملفات
    </button>

    <button
        class="tab-btn"
        onclick="switchTab('databases', this)"
    >
        <i class="fas fa-database"></i>
        قواعد البيانات
    </button>

    <button
        class="tab-btn"
        onclick="switchTab('users', this)"
    >
        <i class="fas fa-user-shield"></i>
        المستخدمين
    </button>

    <button
        class="tab-btn"
        onclick="switchTab('settings', this)"
    >
        <i class="fas fa-sliders"></i>
        الإعدادات
    </button>

</div>

<!-- =====================================================
     CONSOLE
===================================================== -->

<div id="console" class="tab-content active">

    <div class="console-container">

        <div class="console-header">

            <div class="console-status">

                <h2
                    class="console-title"
                    style="font-size:15px;font-weight:800;color:#fff;margin:0;"
                >

                    <span class="console-icon">
                        <i class="fas fa-terminal"></i>
                    </span>

                    <span>
                        <%= server.name %>
                    </span>

                </h2>

                <span
                    class="status-badge <%= server.status === 'running' ? 'running' : 'stopped' %>"
                    id="status-badge"
                >

                    <span id="status-text">

                        <% if (server.status === 'running') { %>

                            <span class="pulse-dot"></span>
                            شغال

                        <% } else { %>

                            <span class="stop-dot"></span>
                            متوقف

                        <% } %>

                    </span>

                </span>

            </div>

            <div class="console-actions">

                <% if (server.status === 'running') { %>

                    <button
                        class="btn btn-danger btn-sm"
                        onclick="stopServer()"
                    >
                        <i class="fas fa-power-off"></i>
                        إيقاف
                    </button>

                    <button
                        class="btn btn-secondary btn-sm"
                        onclick="restartServer()"
                    >
                        <i class="fas fa-rotate"></i>
                        إعادة تشغيل
                    </button>

                <% } else { %>

                    <button
                        class="btn btn-success btn-sm"
                        onclick="startServer()"
                    >
                        <i class="fas fa-play"></i>
                        تشغيل
                    </button>

                <% } %>

                <button
                    class="btn btn-secondary btn-sm"
                    onclick="clearConsole()"
                >
                    <i class="fas fa-broom"></i>
                    مسح
                </button>

            </div>

        </div>

        <div
            class="console-output"
            id="console-output"
        >

            <div class="console-placeholder">

                <div class="console-placeholder-icon">
                    <i class="fas fa-terminal"></i>
                </div>

                <p>
                    الكونسول جاهز لاستقبال سجلات السيرفر
                </p>

            </div>

        </div>

        <div class="console-input-area">

            <input
                type="text"
                class="console-input"
                id="console-input"
                placeholder="اكتب أمر السيرفر..."
                <%= server.status !== 'running' ? 'disabled' : '' %>
            >

            <button
                class="btn btn-primary btn-sm"
                onclick="sendCommand()"
                id="send-btn"
                <%= server.status !== 'running' ? 'disabled' : '' %>
            >
                <i class="fas fa-paper-plane"></i>
                إرسال
            </button>

        </div>

    </div>

</div>

<!-- =====================================================
     FILES
===================================================== -->

<div id="files" class="tab-content">

    <div class="file-manager">

        <div class="file-header">

            <div class="file-actions">

                <button
                    class="btn btn-sm btn-success"
                    onclick="showUploadModal()"
                >
                    <i class="fas fa-cloud-arrow-up"></i>
                    رفع
                </button>

                <button
                    class="btn btn-sm btn-primary"
                    onclick="showCreateFileModal()"
                >
                    <i class="fas fa-file-circle-plus"></i>
                    ملف
                </button>

                <button
                    class="btn btn-sm btn-primary"
                    onclick="showCreateFolderModal()"
                >
                    <i class="fas fa-folder-plus"></i>
                    مجلد
                </button>

                <button
                    class="btn btn-sm btn-info"
                    onclick="refreshFiles()"
                    title="تحديث"
                >
                    <i class="fas fa-rotate"></i>
                </button>

            </div>

        </div>

        <div
            id="bulkActions"
            style="
                display:none;
                padding:11px;
                gap:8px;
                align-items:center;
            "
        >

            <span id="selectedCount">
                0 محدد
            </span>

            <button
                class="btn btn-warning btn-sm"
                onclick="archiveSelected()"
            >
                <i class="fas fa-file-zipper"></i>
                أرشفة
            </button>

            <button
                class="btn btn-danger btn-sm"
                onclick="deleteSelected()"
            >
                <i class="fas fa-trash-can"></i>
                حذف
            </button>

        </div>

        <div
            class="breadcrumb"
            id="breadcrumb"
        >
            <a
                href="#"
                onclick="navigateTo('');return false;"
            >
                <i class="fas fa-house"></i>
                الرئيسية
            </a>
        </div>

        <div style="overflow-x:auto;">

            <table class="file-table">

                <thead>

                    <tr>

                        <th style="width:40px;">
                            <input
                                type="checkbox"
                                id="selectAllFiles"
                                onchange="toggleSelectAll(this)"
                            >
                        </th>

                        <th>الاسم</th>
                        <th>الحجم</th>
                        <th>التاريخ</th>
                        <th style="width:60px;"></th>

                    </tr>

                </thead>

                <tbody id="fileList">

                    <tr>

                        <td
                            colspan="5"
                            style="text-align:center;padding:35px;"
                        >
                            <i class="fas fa-spinner fa-spin"></i>
                            جاري تحميل الملفات...
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- =====================================================
     DATABASES
===================================================== -->

<div id="databases" class="tab-content">

    <div class="file-manager">

        <div class="file-header">

            <div class="file-actions">

                <button
                    class="btn btn-sm btn-success"
                    onclick="showCreateDatabaseModal()"
                >
                    <i class="fas fa-database"></i>
                    <i class="fas fa-plus" style="font-size:8px;margin-right:-4px;"></i>
                    إنشاء قاعدة
                </button>

                <button
                    class="btn btn-sm btn-info"
                    onclick="refreshDatabases()"
                >
                    <i class="fas fa-rotate"></i>
                </button>

            </div>

        </div>

        <div style="overflow-x:auto;">

            <table class="file-table">

                <thead>

                    <tr>
                        <th>الاسم</th>
                        <th>المستخدم</th>
                        <th>المضيف</th>
                        <th>الحجم</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody id="databaseList">

                    <tr>

                        <td
                            colspan="5"
                            style="text-align:center;color:#667085;padding:35px;"
                        >

                            <i
                                class="fas fa-database"
                                style="font-size:30px;display:block;margin-bottom:10px;"
                            ></i>

                            لا توجد قواعد بيانات بعد

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- =====================================================
     USERS
===================================================== -->

<div id="users" class="tab-content">

    <div class="file-manager">

        <div class="file-header">

            <div class="file-actions">

                <button
                    class="btn btn-sm btn-success"
                    onclick="showAddUserModal()"
                >
                    <i class="fas fa-user-plus"></i>
                    إضافة مستخدم
                </button>

                <button
                    class="btn btn-sm btn-info"
                    onclick="refreshServerUsers()"
                >
                    <i class="fas fa-rotate"></i>
                </button>

            </div>

        </div>

        <div style="overflow-x:auto;">

            <table class="file-table">

                <thead>

                    <tr>
                        <th>المستخدم</th>
                        <th>الصلاحية</th>
                        <th>تاريخ الإضافة</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody id="serverUsersList">

                    <tr>

                        <td>
                            <i
                                class="fas fa-crown"
                                style="color:#fbbf24;"
                            ></i>

                            <%= user.username %>
                            <span style="color:#64748b;">
                                (المالك)
                            </span>
                        </td>

                        <td>
                            <span style="color:#34d399;">
                                كل الصلاحيات
                            </span>
                        </td>

                        <td>—</td>

                        <td></td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>

<!-- =====================================================
     SETTINGS
===================================================== -->

<div id="settings" class="tab-content">

    <div class="auth-box" style="max-width:600px;padding:22px;">

        <h3
            style="
                margin-top:0;
                display:flex;
                align-items:center;
                gap:9px;
            "
        >
            <i class="fas fa-sliders" style="color:#818cf8;"></i>
            إعدادات السيرفر
        </h3>

        <div class="form-group">

            <label>
                <i class="fas fa-file-code"></i>
                الملف الرئيسي
            </label>

            <input
                type="text"
                id="mainFile"
                value="<%= server.mainFile %>"
                placeholder="index.js"
            >

        </div>

        <div class="form-group">

            <label>
                <i class="fab fa-node-js"></i>
                إصدار Node.js
            </label>

            <select id="nodeVersion">

                <option
                    value="18"
                    <%= server.nodeVersion === '18' ? 'selected' : '' %>
                >
                    Node.js 18
                </option>

                <option
                    value="20"
                    <%= server.nodeVersion === '20' ? 'selected' : '' %>
                >
                    Node.js 20
                </option>

                <option
                    value="22"
                    <%= server.nodeVersion === '22' ? 'selected' : '' %>
                >
                    Node.js 22
                </option>

                <option
                    value="24"
                    <%= server.nodeVersion === '24' ? 'selected' : '' %>
                >
                    Node.js 24
                </option>

            </select>

        </div>

        <div class="form-group">

            <label>
                <i class="fas fa-key"></i>
                متغيرات البيئة
            </label>

            <textarea
                id="envVariables"
                rows="5"
                placeholder="PORT=3000&#10;TOKEN=xxx"
            ><% if (server.envVariables) { %><% for (const [key, value] of server.envVariables) { %><%= key %>=<%= value %>

<% } %><% } %></textarea>

        </div>

        <hr
            style="
                border:0;
                border-top:1px solid var(--border);
                margin:20px 0;
            "
        >

        <div class="form-group">

            <label>
                <i class="fas fa-box-open"></i>
                تنزيل بكجات البوت
            </label>

            <button
                class="btn btn-success"
                onclick="showPackagesModal()"
            >
                <i class="fas fa-cloud-arrow-down"></i>
                فتح مدير البكجات
            </button>

        </div>

        <button
            class="btn btn-primary"
            onclick="saveSettings()"
        >
            <i class="fas fa-floppy-disk"></i>
            حفظ الإعدادات
        </button>

    </div>

</div>

</div>

<!-- =========================================================
     UPLOAD MODAL
========================================================= -->

<div id="uploadModal" class="modal-overlay">

<div
    class="modal-box"
    style="height:auto;max-width:540px;"
>

    <div class="modal-header">

        <h2>
            <i class="fas fa-cloud-arrow-up"></i>
            رفع الملفات
        </h2>

        <button
            class="btn btn-sm btn-outline"
            onclick="closeModal('uploadModal')"
        >
            <i class="fas fa-xmark"></i>
        </button>

    </div>

    <div
        class="upload-area"
        id="dropZone"
    >

        <i class="fas fa-cloud-arrow-up"></i>

        <p style="margin:0;color:#cbd5e1;">
            اسحب الملفات هنا أو اضغط للاختيار
        </p>

        <small style="color:#64748b;">
            يمكنك رفع أكثر من ملف
        </small>

        <input
            type="file"
            id="fileInput"
            multiple
            style="display:none;"
        >

    </div>

    <div
        id="selectedFiles"
        style="
            color:#fff;
            max-height:150px;
            overflow-y:auto;
            padding:0 15px;
        "
    ></div>

    <label
        style="
            color:#cbd5e1;
            display:flex;
            align-items:center;
            gap:8px;
            margin:15px;
            font-size:12px;
        "
    >

        <input
            type="checkbox"
            id="extractArchive"
        >

        استخراج الأرشيفات تلقائياً

    </label>

    <div
        style="
            display:flex;
            gap:8px;
            margin-top:5px;
        "
    >

        <button
            class="btn btn-success"
            onclick="uploadFiles()"
            style="flex:1;"
        >
            <i class="fas fa-cloud-arrow-up"></i>
            رفع
        </button>

        <button
            class="btn btn-outline"
            onclick="closeModal('uploadModal')"
        >
            إلغاء
        </button>

    </div>

</div>

</div>

<!-- =========================================================
     CREATE FILE
========================================================= -->

<div id="createFileModal" class="modal-overlay">

<div
    class="modal-box"
    style="height:auto;max-width:430px;"
>

    <div class="modal-header">

        <h2>
            <i class="fas fa-file-circle-plus"></i>
            ملف جديد
        </h2>

        <button
            class="btn btn-sm btn-outline"
            onclick="closeModal('createFileModal')"
        >
            <i class="fas fa-xmark"></i>
        </button>

    </div>

    <input
        type="text"
        id="newFileName"
        placeholder="example.js"
        style="width:100%;padding:12px;"
    >

    <div
        style="
            display:flex;
            gap:8px;
            margin-top:15px;
        "
    >

        <button
            class="btn btn-success"
            onclick="createFile()"
            style="flex:1;"
        >
            <i class="fas fa-plus"></i>
            إنشاء
        </button>

        <button
            class="btn btn-outline"
            onclick="closeModal('createFileModal')"
        >
            إلغاء
        </button>

    </div>

</div>

</div>

<!-- =========================================================
     CREATE FOLDER
========================================================= -->

<div id="createFolderModal" class="modal-overlay">

<div
    class="modal-box"
    style="height:auto;max-width:430px;"
>

    <div class="modal-header">

        <h2>
            <i class="fas fa-folder-plus"></i>
            مجلد جديد
        </h2>

        <button
            class="btn btn-sm btn-outline"
            onclick="closeModal('createFolderModal')"
        >
            <i class="fas fa-xmark"></i>
        </button>

    </div>

    <input
        type="text"
        id="newFolderName"
        placeholder="folder"
        style="width:100%;padding:12px;"
    >

    <div
        style="
            display:flex;
            gap:8px;
            margin-top:15px;
        "
    >

        <button
            class="btn btn-success"
            onclick="createFolder()"
            style="flex:1;"
        >
            <i class="fas fa-folder-plus"></i>
            إنشاء
        </button>

        <button
            class="btn btn-outline"
            onclick="closeModal('createFolderModal')"
        >
            إلغاء
        </button>

    </div>

</div>

</div>

<!-- =========================================================
     EDITOR
========================================================= -->

<div id="editorModal" class="modal-overlay">

<div class="modal-box">

    <div class="modal-header">

        <h2>

            <i
                id="editorIcon"
                class="fas fa-file-code"
            ></i>

            <span id="editorTitle">
                تحرير ملف
            </span>

        </h2>

        <div>

            <span
                id="editorLang"
                style="color:#64748b;margin-left:15px;"
            >
                JS
            </span>

            <button
                class="btn btn-sm btn-outline"
                onclick="closeModal('editorModal')"
            >
                <i class="fas fa-xmark"></i>
            </button>

        </div>

    </div>

    <div class="editor-container">

        <textarea id="editor"></textarea>

    </div>

    <div class="editor-footer">

        <div class="editor-status">

            <span id="editorCursor">
                Ln 1, Col 1
            </span>

            <span id="editorSize">
                0 lines
            </span>

        </div>

        <div>

            <button
                class="btn btn-sm btn-success"
