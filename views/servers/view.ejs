<!-- =========================================================
     SCRIPTS
========================================================= -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/css/css.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/htmlmixed/htmlmixed.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/markdown/markdown.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/python/python.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/php/php.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/shell/shell.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/yaml/yaml.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/matchbrackets.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/closebrackets.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/closetag.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/comment/comment.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldcode.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldgutter.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/brace-fold.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/search/search.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/search/searchcursor.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/search/jump-to-line.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/dialog/dialog.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/selection/active-line.min.js"></script>

<script src="/socket.io/socket.io.js"></script>

<script>

const socket = io();

const serverId = '<%= server._id %>';
let serverName = '<%= server.name %>';

/* =========================================================
   SERVER PERMISSIONS
========================================================= */

const currentUserId = '<%= user._id %>';

const isServerOwner =
    '<%= server.owner && server.owner._id ? server.owner._id.toString() : server.owner.toString() %>'
    === currentUserId;

const isSystemAdmin =
    <%= !!(
        user.isOwner ||
        user.isAdmin ||
        config.ownerId === user.discordId ||
        (config.ownerIds || []).includes(user.discordId) ||
        (config.adminIds || []).includes(user.discordId)
    ) %>;

const serverPermissions = <%- JSON.stringify(permissions || {}) %>;

console.log('SERVER DEBUG:', {
    currentUserId,
    isServerOwner,
    isSystemAdmin,
    serverPermissions
});

/* =========================================================
   HIDE UNAUTHORIZED TABS
========================================================= */

if (isServerOwner || isSystemAdmin) {

    Object.keys(serverPermissions).forEach(permission => {
        serverPermissions[permission] = true;
    });

} else {

    const collaborator =
        <%- JSON.stringify(
            (server.collaborators || []).find(c =>
                c.user &&
                c.user._id &&
                c.user._id.toString() === user._id.toString()
            )?.permissions || {}
        ) %>;

    Object.keys(serverPermissions).forEach(permission => {

        serverPermissions[permission] =
            collaborator[permission] === true;

    });

}

let currentPath = '';
let selectedFiles = [];
let selectedPaths = [];
let currentFile = '';
let editor = null;

let startTime = Date.now();
let isRunning = <%= server.status === 'running' %>;

/* =========================================================
   ELEMENTS
========================================================= */

const consoleOutput =
    document.getElementById('console-output');

const consoleInput =
    document.getElementById('console-input');

const sendBtn =
    document.getElementById('send-btn');

const statusBadge =
    document.getElementById('status-badge');

const statusText =
    document.getElementById('status-text');

/* =========================================================
   TOAST SYSTEM
========================================================= */

function showToast(message, type = 'info', title = null) {

    const container =
        document.getElementById('toastContainer');

    const toast =
        document.createElement('div');

    const icons = {

        success: 'fa-circle-check',
        error: 'fa-circle-xmark',
        warning: 'fa-triangle-exclamation',
        info: 'fa-circle-info'

    };

    const titles = {

        success: 'تمت العملية',
        error: 'حدث خطأ',
        warning: 'تنبيه',
        info: 'إشعار'

    };

    toast.className =
        `premium-toast ${type}`;

    toast.innerHTML = `

        <div class="toast-icon">
            <i class="fas ${icons[type] || icons.info}"></i>
        </div>

        <div class="toast-content">

            <div class="toast-title">
                ${escapeHtml(title || titles[type] || 'إشعار')}
            </div>

            <div class="toast-message">
                ${escapeHtml(message)}
            </div>

        </div>

    `;

    container.appendChild(toast);

    setTimeout(() => {

        toast.classList.add('hide');

        setTimeout(() => toast.remove(), 220);

    }, 3500);
}

/* =========================================================
   SOCKET.IO
========================================================= */

socket.on('connect', () => {

    socket.emit('joinServer', serverId);

    socket.emit('get-console-history', {
        serverId
    });

});

socket.on('console-log', data => {

    addLogLine(
        data.type,
        data.message,
        data.timestamp || Date.now()
    );

});

socket.on('console-history', logs => {

    if (!logs || !logs.length) return;

    consoleOutput.innerHTML = '';

    logs.forEach(log => {

        addLogLine(
            log.type,
            log.message,
            log.timestamp
        );

    });

});

socket.on('status-update', data => {

    if (data.id !== serverId) return;

    isRunning =
        data.status === 'running';

    updateStatusUI(isRunning);

    if (isRunning) {

        startTime = Date.now();

    }

});

socket.on('resource-update', data => {

    if (data.id !== serverId) return;

    const cpu =
        Math.min(100, Math.max(0, Number(data.cpu) || 0));

    const ram =
        Math.min(100, Math.max(0, Number(data.ramPercent) || 0));

    const disk =
        Math.min(100, Math.max(0, Number(data.diskPercent) || 0));

    document.getElementById('cpuPercent').textContent =
        cpu + '%';

    document.getElementById('ramPercent').textContent =
        ram + '%';

    document.getElementById('diskPercent').textContent =
        disk + '%';

    const cpuBar =
        document.getElementById('cpuBar');

    const ramBar =
        document.getElementById('ramBar');

    const diskBar =
        document.getElementById('diskBar');

    if (cpuBar)
        cpuBar.style.width = cpu + '%';

    if (ramBar)
        ramBar.style.width = ram + '%';

    if (diskBar)
        diskBar.style.width = disk + '%';

});

/* =========================================================
   CONSOLE
========================================================= */

function addLogLine(type, message, timestamp) {

    const placeholder =
        consoleOutput.querySelector('.console-placeholder');

    if (placeholder)
        placeholder.remove();

    const line =
        document.createElement('div');

    line.className = 'log-line';

    const time =
        new Date(timestamp || Date.now())
            .toLocaleTimeString('en-US', {
                hour12: false
            });

    let colorClass = 'log-stdout';

    if (type === 'stderr')
        colorClass = 'log-stderr';

    else if (type === 'info')
        colorClass = 'log-info';

    else if (type === 'command')
        colorClass = 'log-command';

    line.innerHTML = `

        <span class="log-time">
            [${time}]
        </span>

        <span class="${colorClass}">
            ${escapeHtml(String(message ?? ''))}
        </span>

    `;

    consoleOutput.appendChild(line);

    consoleOutput.scrollTop =
        consoleOutput.scrollHeight;

    while (consoleOutput.children.length > 500) {

        consoleOutput.removeChild(
            consoleOutput.children[0]
        );

    }

}

function escapeHtml(text) {

    const div =
        document.createElement('div');

    div.textContent =
        text;

    return div.innerHTML;

}

function updateStatusUI(running) {

    isRunning = running;

    const serverStatusEl =
        document.getElementById('serverStatus');

    if (running) {

        statusBadge.className =
            'status-badge running';

        statusText.innerHTML =
            '<span class="pulse-dot"></span> شغال';

        serverStatusEl.innerHTML =
            'يعمل';

        serverStatusEl.className =
            'server-status status-running';

    } else {

        statusBadge.className =
            'status-badge stopped';

        statusText.innerHTML =
            '<span class="stop-dot"></span> متوقف';

        serverStatusEl.innerHTML =
            'متوقف';

        serverStatusEl.className =
            'server-status status-stopped';

    }

    /*
     * Console permission
     */

    consoleInput.disabled =
        !serverPermissions.consoleCommand ||
        !running;

    sendBtn.disabled =
        !serverPermissions.consoleCommand ||
        !running;


    /*
     * Console actions
     */

    const actions =
        document.querySelector('.console-actions');

    if (!actions)
        return;

    let html = '';

    if (!running) {

        if (serverPermissions.start) {

            html += `

                <button
                    class="btn btn-success btn-sm"
                    onclick="startServer()"
                >
                    <i class="fas fa-play"></i>
                    تشغيل
                </button>

            `;

        }

    } else {

        if (serverPermissions.stop) {

            html += `

                <button
                    class="btn btn-danger btn-sm"
                    onclick="stopServer()"
                >
                    <i class="fas fa-power-off"></i>
                    إيقاف
                </button>

            `;

        }

        if (serverPermissions.restart) {

            html += `

                <button
                    class="btn btn-secondary btn-sm"
                    onclick="restartServer()"
                >
                    <i class="fas fa-rotate"></i>
                    إعادة تشغيل
                </button>

            `;

        }

    }

    if (serverPermissions.console) {

        html += `

            <button
                class="btn btn-secondary btn-sm"
                onclick="clearConsole()"
            >
                <i class="fas fa-broom"></i>
                مسح
            </button>

        `;

    }

    actions.innerHTML = html;

}

function sendCommand() {

    if (!serverPermissions.consoleCommand) {

        showToast(
            'ليس لديك صلاحية إرسال أوامر Console.',
            'error'
        );

        return;

    }

    const command =
        consoleInput.value.trim();

    if (!command || !isRunning)
        return;

    socket.emit('console-command', {
        serverId,
        command
    });

    addLogLine(
        'command',
        `> ${command}`,
        Date.now()
    );

    consoleInput.value = '';

}

function clearConsole() {

    consoleOutput.innerHTML = `

        <div class="console-placeholder">

            <div class="console-placeholder-icon">
                <i class="fas fa-broom"></i>
            </div>

            <p>
                تم تنظيف الكونسول
            </p>

        </div>

    `;

}

async function startServer() {

    if (!serverPermissions.start) {

        showToast(
            'ليس لديك صلاحية تشغيل السيرفر.',
            'error'
        );

        return;

    }

    try {

        showToast(
            'جاري إرسال طلب تشغيل السيرفر...',
            'info'
        );

        const res =
            await fetch(
                `/servers/${serverId}/start`,
                { method: 'POST' }
            );

        const data =
            await res.json();

        if (data.success) {

            updateStatusUI(true);

            showToast(
                'تم تشغيل السيرفر بنجاح.',
                'success'
            );

        } else {

            showToast(
                data.error || 'فشل تشغيل السيرفر.',
                'error'
            );

        }

    } catch (err) {

        showToast(
            'تعذر الاتصال بالخادم.',
            'error'
        );

    }

}

async function stopServer() {

    if (!serverPermissions.stop) {

        showToast(
            'ليس لديك صلاحية إيقاف السيرفر.',
            'error'
        );

        return;

    }

    try {

        const res =
            await fetch(
                `/servers/${serverId}/stop`,
                { method: 'POST' }
            );

        const data =
            await res.json();

        if (data.success) {

            updateStatusUI(false);

            showToast(
                'تم إيقاف السيرفر.',
                'success'
            );

        } else {

            showToast(
                data.error || 'فشل إيقاف السيرفر.',
                'error'
            );

        }

    } catch (err) {

        showToast(
            'تعذر الاتصال بالخادم.',
            'error'
        );

    }

}

async function restartServer() {

    if (!serverPermissions.restart) {

        showToast(
            'ليس لديك صلاحية إعادة تشغيل السيرفر.',
            'error'
        );

        return;

    }

    try {

        showToast(
            'جاري إعادة تشغيل السيرفر...',
            'info'
        );

        const res =
            await fetch(
                `/servers/${serverId}/restart`,
                { method: 'POST' }
            );

        const data =
            await res.json();

        if (data.success) {

            updateStatusUI(true);

            showToast(
                'تمت إعادة تشغيل السيرفر.',
                'success'
            );

        } else {

            showToast(
                data.error || 'فشل إعادة التشغيل.',
                'error'
            );

        }

    } catch (err) {

        showToast(
            'تعذر الاتصال بالخادم.',
            'error'
        );

    }

}

consoleInput.addEventListener(
    'keypress',
    e => {

        if (e.key === 'Enter')
            sendCommand();

    }
);

/* =========================================================
   UPTIME
========================================================= */

setInterval(() => {

    if (!isRunning) {

        document.getElementById('uptime')
            .textContent = '—';

        return;

    }

    const uptime =
        Math.floor(
            (Date.now() - startTime) / 1000
        );

    const hours =
        Math.floor(uptime / 3600);

    const minutes =
        Math.floor((uptime % 3600) / 60);

    const seconds =
        uptime % 60;

    document.getElementById('uptime')
        .textContent =
        `${hours}h ${minutes}m ${seconds}s`;

}, 1000);

/* =========================================================
   TABS
========================================================= */

function switchTab(id, el) {

    const requiredPermissions = {

        console: 'console',
        files: 'files',
        packages: 'packages',
        settings: 'settings',
        users: null,
        databases: 'packages'

    };

    if (id === 'users') {

        if (!isServerOwner && !isSystemAdmin) {

            showToast(
                'فقط صاحب السيرفر يستطيع إدارة المستخدمين.',
                'error'
            );

            return;
        }

    } else {

        const permission = requiredPermissions[id];

        if (
            permission &&
            !serverPermissions[permission]
        ) {

            showToast(
                'ليس لديك صلاحية الوصول إلى هذا القسم.',
                'error'
            );

            return;
        }
    }

    document.querySelectorAll('.tab-content')
        .forEach(t => t.classList.remove('active'));

    document.querySelectorAll('.tab-btn')
        .forEach(b => b.classList.remove('active'));

    const target = document.getElementById(id);

    if (!target) {
        return;
    }

    target.classList.add('active');

    if (el) {
        el.classList.add('active');
    }

    if (id === 'files') {
        refreshFiles();
    }

    if (id === 'databases') {
        refreshDatabases();
    }

    if (id === 'users') {
        refreshServerUsers();
    }
}

/* =========================================================
   DATABASES
========================================================= */

async function refreshDatabases() {

    try {

        const r =
            await fetch(
                `/servers/${serverId}/databases`
            );

        const d =
            await r.json();

        const list =
            document.getElementById('databaseList');

        if (!d.databases ||
            d.databases.length === 0) {

            list.innerHTML = `

                <tr>

                    <td
                        colspan="5"
                        style="
                            text-align:center;
                            color:#667085;
                            padding:35px;
                        "
                    >

                        <i
                            class="fas fa-database"
                            style="
                                font-size:30px;
                                display:block;
                                margin-bottom:10px;
                            "
                        ></i>

                        لا توجد قواعد بيانات بعد

                    </td>

                </tr>

            `;

            return;

        }

        list.innerHTML =
            d.databases.map(db => `

                <tr>

                    <td>
                        <i
                            class="fas fa-database"
                            style="color:#818cf8;margin-left:7px;"
                        ></i>
                        ${escapeHtml(db.name)}
                    </td>

                    <td>
                        ${escapeHtml(db.username || '-')}
                    </td>

                    <td>
                        ${escapeHtml(db.host || '-')}
                    </td>

                    <td>
                        ${escapeHtml(db.size || '-')}
                    </td>

                    <td>

                        <button
                            class="btn btn-sm btn-danger"
                            onclick="deleteDatabase('${db.id}')"
                        >
                            <i class="fas fa-trash-can"></i>
                        </button>

                    </td>

                </tr>

            `).join('');

    } catch (err) {

        console.warn(
            'Database endpoint unavailable',
            err
        );

    }

}

function showCreateDatabaseModal() {

    const name =
        prompt('اسم قاعدة البيانات:');

    if (!name)
        return;

    fetch(
        `/servers/${serverId}/databases`,
        {
            method: 'POST',
            headers: {
                'Content-Type':
                    'application/json'
            },
            body:
                JSON.stringify({ name })
        }
    )
    .then(() => {

        showToast(
            'تم إرسال طلب إنشاء قاعدة البيانات.',
            'success'
        );

        refreshDatabases();

    })
    .catch(() => {

        showToast(
            'فشل إنشاء قاعدة البيانات.',
            'error'
        );

    });

}

function deleteDatabase(id) {

    if (!confirm(
        'هل تريد حذف قاعدة البيانات؟'
    ))
        return;

    fetch(
        `/servers/${serverId}/databases/${id}`,
        {
            method: 'DELETE'
        }
    )
    .then(() => {

        showToast(
            'تم حذف قاعدة البيانات.',
            'success'
        );

        refreshDatabases();

    })
    .catch(() => {

        showToast(
            'فشل حذف قاعدة البيانات.',
            'error'
        );

    });

}

/* =========================================================
   COLLABORATORS / USERS
========================================================= */

async function refreshServerUsers() {

    try {

        const r =
            await fetch(
                `/servers/${serverId}/users`
            );

        const d =
            await r.json();

        if (!d.users)
            return;

        const list =
            document.getElementById(
                'serverUsersList'
            );

        if (!list)
            return;

        const ownerRow = `

            <tr>

                <td>

                    <i
                        class="fas fa-crown"
                        style="
                            color:#fbbf24;
                            margin-left:7px;
                        "
                    ></i>

                    ${escapeHtml(serverName)}

                    <span style="color:#64748b;">
                        (المالك)
                    </span>

                </td>

                <td>
                    <span style="color:#34d399;">
                        كل الصلاحيات
                    </span>
                </td>

                <td>—</td>

                <td>—</td>

            </tr>

        `;

        const collaborators =
            d.users.map(u => {

                const permissionCount =
                    u.permissions
                        ? Object.values(u.permissions)
                            .filter(Boolean)
                            .length
                        : 0;

                return `

                    <tr>

                        <td>

                            <i
                                class="fas fa-user-group"
                                style="
                                    color:#22c55e;
                                    margin-left:7px;
                                "
                            ></i>

                            ${escapeHtml(
                                u.username || 'مستخدم'
                            )}

                            ${
                                u.email
                                ? `
                                    <div
                                        style="
                                            font-size:12px;
                                            color:#64748b;
                                            margin-top:4px;
                                        "
                                    >
                                        ${escapeHtml(u.email)}
                                    </div>
                                `
                                : ''
                            }

                            ${
                                u.discordId
                                ? `
                                    <div
                                        style="
                                            font-size:11px;
                                            color:#475569;
                                            margin-top:3px;
                                        "
                                    >
                                        Discord:
                                        ${escapeHtml(u.discordId)}
                                    </div>
                                `
                                : ''
                            }

                        </td>

                        <td>

                            <span
                                style="
                                    color:#34d399;
                                "
                            >
                                ${permissionCount}
                                صلاحية
                            </span>

                        </td>

                        <td>

                            ${
                                u.addedAt
                                ? new Date(
                                    u.addedAt
                                ).toLocaleDateString('ar')
                                : '—'
                            }

                        </td>

                        <td>

                            <button
                                class="btn btn-sm btn-secondary"
                                onclick="
                                    editCollaboratorPermissions(
                                        '${u.id}'
                                    )
                                "
                                title="الصلاحيات"
                            >
                                <i class="fas fa-shield-halved"></i>
                            </button>

                            <button
                                class="btn btn-sm btn-danger"
                                onclick="
