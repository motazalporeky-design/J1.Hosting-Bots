<!DOCTYPE html>

<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">

<title><%= server.name %> - J1 Studio</title>

<link rel="stylesheet" href="/css/style.css">

<!-- CodeMirror -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/dracula.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/fold/foldgutter.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/dialog/dialog.min.css">

<!-- Font Awesome -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

<style>

    /* =========================================================
       PREMIUM VARIABLES
    ========================================================= */

:root {
--bg: #030806;
--bg-2: #06100b;

--panel: rgba(8, 20, 13, .94);
--panel-2: #08150e;
--panel-3: #0c1d13;

--border: rgba(74, 222, 128, .09);
--border-hover: rgba(34, 197, 94, .32);

--text: #f0fdf4;
--muted: #8aa494;
--muted-2: #607568;

/* اللون الأساسي الأخضر الغامق */
--primary: #15803d;
--primary-2: #22c55e;

--success: #16a34a;
--danger: #ef4444;
--warning: #f59e0b;
--info: #38bdf8;

--radius: 16px;
--shadow: 0 20px 60px rgba(0, 0, 0, .45);

}

    html, body {
        min-height: 100%;
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

body {
background:
linear-gradient(
rgba(3, 8, 6, .72),
rgba(3, 8, 6, .88)
),
url('/images/background.png') center center / cover fixed no-repeat,
radial-gradient(
circle at 10% 0%,
rgba(21, 128, 61, .13),
transparent 28%
),
radial-gradient(
circle at 90% 10%,
rgba(34, 197, 94, .055),
transparent 25%
),
var(--bg);

background-attachment: fixed;
color: var(--text);
min-height: 100vh;
}

    button,
    input,
    select,
    textarea {
        font-family: inherit;
    }

::selection {
background: rgba(34, 197, 94, .30);
color: #f0fdf4;
}

::-webkit-scrollbar {
width: 7px;
height: 7px;
}

::-webkit-scrollbar-track {
background: #030806;
}

::-webkit-scrollbar-thumb {
background: #123c24;
border-radius: 20px;
}

::-webkit-scrollbar-thumb {
background: #166534;
}

    /* =========================================================
       NAVBAR
    ========================================================= */

.navbar {
background: rgba(3,8,6,.88) !important;
border-bottom: 1px solid var(--border) !important;
backdrop-filter: blur(20px);
-webkit-backdrop-filter: blur(20px);
position: sticky;
top: 0;
z-index: 5000;
}

    .navbar .container {
        min-height: 72px;
    }

    .logo {
        display: inline-flex !important;
        align-items: center;
        gap: 10px;
        color: #fff !important;
        font-weight: 800;
        text-decoration: none;
        letter-spacing: -.3px;
    }

.logo::before {
content: "\f233";
font-family: "Font Awesome 6 Free";
font-weight: 900;

width: 36px;
height: 36px;

display: flex;
align-items: center;
justify-content: center;

border-radius: 11px;

background: linear-gradient(
    135deg,
    #14532d,
    #16a34a
);

color: #dcfce7;

box-shadow:
    0 8px 25px rgba(22, 163, 74, .28),
    inset 0 1px 0 rgba(255,255,255,.08);

}

    .user-info {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #e5e7eb;
        font-weight: 600;
    }

    .avatar {
        width: 36px !important;
        height: 36px !important;
        border-radius: 12px !important;
        object-fit: cover;
        border: 2px solid rgba(34,197,94,.28);

box-shadow:
0 5px 20px rgba(0,0,0,.35),
0 0 15px rgba(34,197,94,.05);
box-shadow: 0 5px 20px rgba(0,0,0,.35);
}

    .coins-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 13px;
        border-radius: 12px;
        background: rgba(245,158,11,.08);
        border: 1px solid rgba(245,158,11,.16);
        color: #fbbf24;
        font-weight: 700;
    }

    .coins-badge::before {
        content: "\f51e";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
    }

    .coins-badge {
        font-size: 0;
    }

    .coins-badge::after {
        content: "<%= user.coins %>";
        font-size: 13px;
    }

    .coins-badge::before {
        font-size: 13px;
    }

    /* =========================================================
       SERVER HEADER
    ========================================================= */

.server-header-detail {
background:
linear-gradient(
135deg,
rgba(21, 128, 61, .13),
rgba(15, 35, 23, .78) 45%,
rgba(3, 10, 6, .96)
);

border: 1px solid rgba(34, 197, 94, .11);

box-shadow:
    0 20px 60px rgba(0,0,0,.40),
    inset 0 1px 0 rgba(74,222,128,.025);

}

    .server-header-detail h1 {
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: clamp(22px,3vw,32px);
        font-weight: 800;
        letter-spacing: -.7px;
    }

    .server-header-detail h1::before {
        content: "\f233";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        color: var(--primary-2);
        font-size: 20px;
    }

    .server-status {
        display: inline-flex !important;
        align-items: center;
        gap: 8px;
        padding: 9px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        border: 1px solid transparent;
    }

    .server-status::before {
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
    }

    .status-running {
        background: rgba(16,185,129,.08) !important;
        border-color: rgba(16,185,129,.18) !important;
        color: #34d399 !important;
    }

    .status-running::before {
        content: "\f058";
    }

    .status-stopped {
        background: rgba(239,68,68,.08) !important;
        border-color: rgba(239,68,68,.18) !important;
        color: #f87171 !important;
    }

    .status-stopped::before {
        content: "\f057";
    }

    /* =========================================================
       STAT CARDS
    ========================================================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0,1fr));
        gap: 14px;
        margin: 18px 0 22px;
    }

    .stat-card {
        position: relative;
        overflow: hidden;

        background:
            linear-gradient(145deg,
                rgba(17,24,39,.92),
                rgba(8,11,19,.96));

        border: 1px solid var(--border);
        border-radius: var(--radius);

        padding: 18px;

        display: flex;
        align-items: center;
        gap: 13px;

        transition: .25s ease;
    }

    .stat-card::after {
        content: "";
        position: absolute;
        width: 100px;
        height: 100px;
        right: -45px;
        top: -45px;
        border-radius: 50%;
        background: rgba(34,197,94,.07);
        filter: blur(10px);
    }

    .stat-card:hover {
        transform: translateY(-3px);
        border-color: var(--border-hover);
        box-shadow: 0 15px 40px rgba(0,0,0,.25);
    }

    .stat-icon {
width: 48px;
height: 48px;
min-width: 48px;
border-radius: 14px;

display: flex;
align-items: center;
justify-content: center;

background: rgba(21,128,61,.09);
border: 1px solid rgba(34,197,94,.13);

color: #4ade80;
font-size: 19px;

box-shadow:
    inset 0 0 15px rgba(34,197,94,.025);

}

    .stat-content {
        min-width: 0;
    }

    .stat-content h3 {
        margin: 0 0 3px;
        color: #fff;
        font-size: 20px;
        font-weight: 800;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .stat-content p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .8px;
    }

#serverAddress {
color: #bbf7d0 !important;
}

    /* =========================================================
       TABS
    ========================================================= */

    .server-tabs {
        display: flex;
        gap: 5px;
        padding: 6px;
        margin: 18px 0;
        overflow-x: auto;

        background: rgba(10,14,23,.8);
        border: 1px solid var(--border);
        border-radius: 14px;

        scrollbar-width: none;
    }

    .server-tabs::-webkit-scrollbar {
        display: none;
    }

    .tab-btn {
        position: relative;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;

        padding: 11px 17px;

        background: transparent;
        border: 0;
        border-radius: 10px;

        color: var(--muted);
        cursor: pointer;
        font-size: 13px;
        font-weight: 700;

        white-space: nowrap;
        transition: .2s ease;
    }

    .tab-btn i {
        font-size: 13px;
    }

.tab-btn {
color: #fff;
background: rgba(34,197,94,.045);
}

.tab-btn.active {
color: #fff;

background: linear-gradient(
    135deg,
    rgba(21, 128, 61, .25),
    rgba(34, 197, 94, .07)
);

box-shadow:
    inset 0 0 0 1px rgba(34, 197, 94, .16),
    0 5px 18px rgba(0,0,0,.18);

}

.tab-btn.active::after {
background: #22c55e;

box-shadow:
    0 0 12px rgba(34,197,94,.65);

}

    .tab-content {
        display: none;
        padding: 5px 0 25px;
        animation: fadeUp .25s ease;
    }

    .tab-content.active {
        display: block;
    }

    @keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(5px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
       PREMIUM BUTTONS
    ========================================================= */

    .btn {
        border-radius: 10px !important;
        font-weight: 700 !important;
        transition: .2s ease !important;
    }

    .btn:hover {
        transform: translateY(-1px);
    }

.btn-primary {
background: linear-gradient(
135deg,
#166534,
#15803d
) !important;

border: 1px solid rgba(74,222,128,.25) !important;

box-shadow:
    0 8px 22px rgba(21,128,61,.20);

}

.btn-primary {
background: linear-gradient(
135deg,
#15803d,
#16a34a
) !important;

box-shadow:
    0 10px 28px rgba(34,197,94,.25);

}

    .btn-success {
        background: linear-gradient(135deg,#059669,#10b981) !important;
        border: 1px solid rgba(16,185,129,.25) !important;
    }

    .btn-danger {
        background: linear-gradient(135deg,#dc2626,#ef4444) !important;
        border: 1px solid rgba(239,68,68,.25) !important;
    }

    .btn-secondary {
        background: #151b29 !important;
        border: 1px solid var(--border) !important;
    }

.btn-info {
background: rgba(34,197,94,.08) !important;
color: #4ade80 !important;
border: 1px solid rgba(34,197,94,.16) !important;
}

.btn-warning {
background: rgba(34,197,94,.08) !important;
color: #4ade80 !important;
border: 1px solid rgba(34,197,94,.16) !important;
}

    .btn-outline {
        background: rgba(255,255,255,.025) !important;
        border: 1px solid var(--border) !important;
        color: #d1d5db !important;
    }

    /* =========================================================
       CONSOLE
    ========================================================= */

    .console-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 340px);
        min-height: 520px;

        background: #06080e;
        border: 1px solid var(--border);
        border-radius: 18px;
        overflow: hidden;

        box-shadow: var(--shadow);
    }

    .console-header {
        min-height: 64px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 12px 16px;

        background:
            linear-gradient(
                180deg,
                rgba(18,24,37,.98),
                rgba(11,15,24,.98)
            );

        border-bottom: 1px solid var(--border);

        gap: 12px;
        flex-wrap: wrap;
    }

    .console-status {
        display: flex;
        align-items: center;
        gap: 12px;
    }

.console-icon {
width: 35px;
height: 35px;

display: inline-flex;
align-items: center;
justify-content: center;

border-radius: 10px;

background: rgba(21,128,61,.10);
border: 1px solid rgba(34,197,94,.16);

color: #4ade80 !important;
font-size: 13px !important;

box-shadow:
    0 0 20px rgba(34,197,94,.04);

}

    .console-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;

        padding: 7px 11px;
        border-radius: 999px;

        font-size: 11px;
        font-weight: 800;
    }

    .status-badge.running {
        color: #34d399;
        background: rgba(16,185,129,.08);
        border: 1px solid rgba(16,185,129,.14);
    }

    .status-badge.stopped {
        color: #f87171;
        background: rgba(239,68,68,.08);
        border: 1px solid rgba(239,68,68,.14);
    }

    .pulse-dot,
    .stop-dot {
        width: 7px;
        height: 7px;
        display: inline-block;
        border-radius: 50%;
    }

    .pulse-dot {
        background: #10b981;
        box-shadow: 0 0 0 4px rgba(16,185,129,.08);
        animation: pulse 1.6s infinite;
    }

    .stop-dot {
        background: #ef4444;
    }

    @keyframes pulse {
        0%,100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: .45;
            transform: scale(.8);
        }
    }

    .console-actions {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

   .console-output {
flex: 1;

padding: 17px;

overflow-y: auto;

background:
    radial-gradient(
        circle at 80% 20%,
        rgba(34,197,94,.035),
        transparent 25%
    ),
    #020604;

font-family: "Fira Code","Cascadia Code","Consolas",monospace;
font-size: 12px;
line-height: 1.75;

color: #d1fae5;

direction: ltr;
text-align: left;

white-space: pre-wrap;
word-break: break-word;

border: 0;

}

    .console-output::before {
        content: "SYSTEM CONSOLE";
        display: block;
        color: #30394d;
        font-size: 9px;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .console-input-area {
        display: flex;
        align-items: center;
        gap: 8px;

        padding: 10px;

        background: #0b0f18;
        border-top: 1px solid var(--border);
    }

    .console-input {
        flex: 1;

        height: 42px;

        background: #070a11 !important;
        border: 1px solid var(--border) !important;
        border-radius: 10px !important;

        padding: 0 13px !important;

        color: #fff !important;

        font-family: "Fira Code","Consolas",monospace;
        font-size: 12px;

        outline: none;
    }

    .console-input:focus {
        border-color: rgba(99,102,241,.5) !important;
        box-shadow: 0 0 0 3px rgba(99,102,241,.07);
    }

    .log-line {
        padding: 1px 0;
    }

    .log-time {
        color: #394257;
        margin-right: 10px;
        user-select: none;
    }

    .log-stdout {
        color: #cbd5e1;
    }

    .log-stderr {
        color: #fb7185;
    }

    .log-info {
        color: #60a5fa;
    }

    .log-command {
        color: #fbbf24;
    }

    .console-placeholder {
        height: 100%;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        color: #475166;
    }

.console-placeholder-icon {
width: 70px;
height: 70px;

display: flex;
align-items: center;
justify-content: center;

margin-bottom: 15px;

border-radius: 20px;

background: rgba(21,128,61,.07);
border: 1px solid rgba(34,197,94,.13);

color: #22c55e;
font-size: 25px;

box-shadow:
    0 0 30px rgba(34,197,94,.05);

}

    /* =========================================================
       RESOURCE BARS
    ========================================================= */

    .resource-box {
        margin-top: 20px;
        padding: 20px;

        background: rgba(13,17,28,.8);
        border: 1px solid var(--border);
        border-radius: var(--radius);
    }

    .resource-item {
        margin-bottom: 18px;
    }

    .resource-item:last-child {
        margin-bottom: 0;
    }

    .resource-header {
        display: flex;
        justify-content: space-between;

        margin-bottom: 8px;

        color: #e5e7eb;
        font-size: 13px;
        font-weight: 700;
    }

    .progress-bar {
        width: 100%;
        height: 8px;

        overflow: hidden;

        background: #05070d;
        border-radius: 999px;
    }

    .progress-fill {
        height: 100%;
        width: 0;

        border-radius: inherit;

        transition: width .4s ease;
    }

    .cpu-fill {
        background: linear-gradient(90deg,#6366f1,#818cf8);
    }

    .ram-fill {
        background: linear-gradient(90deg,#059669,#34d399);
    }

    .disk-fill {
        background: linear-gradient(90deg,#d97706,#fbbf24);
    }

    /* =========================================================
       FILE MANAGER
    ========================================================= */

    .file-manager {
        overflow: hidden;

        background: rgba(10,14,23,.86);
        border: 1px solid var(--border);
        border-radius: var(--radius);

        box-shadow: 0 15px 45px rgba(0,0,0,.2);
    }

    .file-header {
        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 13px;

        background: rgba(17,24,39,.72);
        border-bottom: 1px solid var(--border);

        gap: 10px;
        flex-wrap: wrap;
    }

    .file-actions {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .breadcrumb {
        padding: 11px 15px;

        background: #080b12;
        border-bottom: 1px solid var(--border);

        overflow-x: auto;
        white-space: nowrap;

        font-size: 12px;
    }

    .breadcrumb a {
        color: #818cf8;
        text-decoration: none;
    }

    .file-table {
        width: 100%;
        border-collapse: collapse;
    }

    .file-table th {
        text-align: right;

        padding: 12px 15px;

        background: rgba(17,24,39,.6);

        color: #667085;

        font-size: 11px;
        font-weight: 800;

        text-transform: uppercase;
    }

    .file-table td {
        padding: 11px 15px;
        border-bottom: 1px solid rgba(255,255,255,.045);

        color: #cbd5e1;
        font-size: 12px;
    }

    .file-table tbody tr {
        transition: .15s ease;
    }

    .file-table tbody tr:hover {
        background: rgba(99,102,241,.045);
    }

    .file-name {
        display: inline-flex;
        align-items: center;
        gap: 9px;

        cursor: pointer;

        color: #e5e7eb;
        font-weight: 600;
    }

    .file-name:hover {
        color: #a5b4fc;
    }

    .file-icon {
        width: 24px;
        text-align: center;
    }

    .fa-folder {
        color: #fbbf24;
    }

    .fa-js {
        color: #f7df1e;
    }

    .fa-html5 {
        color: #f97316;
    }

    .fa-css3-alt {
        color: #38bdf8;
    }

    .fa-python {
        color: #60a5fa;
    }

    .fa-php {
        color: #818cf8;
    }

    .fa-markdown {
        color: #94a3b8;
    }

    /* =========================================================
       FILE MENU
    ========================================================= */

    .file-actions-menu {
        position: relative;
        display: inline-block;
    }

    .menu-dots {
        width: 34px;
        height: 34px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        background: transparent;
        border: 1px solid transparent;
        border-radius: 9px;

        color: #64748b;

        cursor: pointer;

        transition: .2s ease;
    }

    .menu-dots:hover {
        color: #fff;
        background: rgba(255,255,255,.05);
        border-color: var(--border);
    }

    .menu-dropdown {
        display: none;

        position: absolute;
        left: 0;
        top: calc(100% + 5px);

        min-width: 185px;

        background: #101521;

        border: 1px solid rgba(255,255,255,.08);
        border-radius: 12px;

        z-index: 2000;

        padding: 5px;

        box-shadow:
            0 25px 60px rgba(0,0,0,.5),
            0 0 0 1px rgba(0,0,0,.2);
    }

    .menu-dropdown.active {
        display: block;
        animation: menuIn .15s ease;
    }

    @keyframes menuIn {
        from {
            opacity: 0;
            transform: translateY(-4px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .menu-item {
        display: flex;
        align-items: center;
        gap: 10px;

        padding: 10px;

        border-radius: 8px;

        color: #cbd5e1;
        cursor: pointer;

        font-size: 12px;

        transition: .15s ease;
    }

    .menu-item:hover {
        background: rgba(99,102,241,.1);
        color: #fff;
    }

    .menu-item i {
        width: 18px;
        text-align: center;
        color: #818cf8;
    }

    .menu-item.danger {
        color: #fb7185;
    }

    .menu-item.danger i {
        color: #fb7185;
    }

    .menu-item.danger:hover {
        background: rgba(239,68,68,.08);
    }

    /* =========================================================
       BULK ACTIONS
    ========================================================= */

    #bulkActions {
        background: rgba(99,102,241,.05) !important;
        border-bottom: 1px solid rgba(99,102,241,.1) !important;
    }

    #selectedCount {
        font-size: 12px;
        font-weight: 700;
    }

    /* =========================================================
       MODALS
    ========================================================= */

    .modal-overlay {
        display: none;

        position: fixed;
        inset: 0;

        width: 100%;
        height: 100%;

        background: rgba(0,0,0,.78);

        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        z-index: 10000;

        align-items: center;
        justify-content: center;

        padding: 15px;
    }

    .modal-overlay.active {
        display: flex;
        animation: modalFade .18s ease;
    }

    @keyframes modalFade {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .modal-box {
        background:
            linear-gradient(
                145deg,
                #111725,
                #080b12
            );

        border: 1px solid rgba(255,255,255,.08);
        border-radius: 18px;

        padding: 20px;

        width: 95%;
        max-width: 1400px;
        height: 90vh;

        display: flex;
        flex-direction: column;

        box-shadow:
            0 35px 100px rgba(0,0,0,.6),
            0 0 0 1px rgba(0,0,0,.3);

        animation: modalUp .2s ease;
    }

    @keyframes modalUp {
        from {
            opacity: 0;
            transform: translateY(12px) scale(.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-bottom: 15px;
        padding-bottom: 12px;

        border-bottom: 1px solid var(--border);
    }

    .modal-header h2 {
        margin: 0;

        display: flex;
        align-items: center;
        gap: 9px;

        color: #fff;
        font-size: 16px;
    }

    .modal-header h2 i {
        color: #818cf8;
    }

    .editor-container {
        flex: 1;
        overflow: hidden;

        border: 1px solid var(--border);
        border-radius: 12px;
    }

    .editor-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;

        margin-top: 12px;
        padding-top: 12px;

        border-top: 1px solid var(--border);

        flex-wrap: wrap;
        gap: 10px;
    }

    .editor-status {
        display: flex;
        gap: 18px;

        color: #64748b;
        font-size: 11px;
    }

    .upload-area {
        border: 2px dashed rgba(99,102,241,.2);
        border-radius: 14px;

        padding: 45px 25px;

        text-align: center;

        margin: 15px;

        cursor: pointer;

        color: #94a3b8;

        background: rgba(99,102,241,.025);

        transition: .25s ease;
    }

    .upload-area i {
        display: block;
        margin-bottom: 10px;

        font-size: 30px;
        color: #818cf8;
    }

    .upload-area:hover {
        border-color: rgba(99,102,241,.55);
        background: rgba(99,102,241,.06);
    }

    /* =========================================================
       FORMS
    ========================================================= */

    .auth-box {
        background: rgba(13,17,28,.9) !important;
        border: 1px solid var(--border) !important;
        border-radius: 16px !important;
        box-shadow: var(--shadow);
    }

    .form-group label {
        color: #cbd5e1 !important;
        font-size: 12px;
        font-weight: 700;
    }

    .form-group input,
    .form-group select,
    .form-group textarea,
    .modal-box input,
    .modal-box select {
        background: #070a11 !important;
        border: 1px solid var(--border) !important;
        color: #fff !important;

        border-radius: 10px !important;

        transition: .2s ease;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus,
    .modal-box input:focus,
    .modal-box select:focus {
        border-color: rgba(99,102,241,.5) !important;
        box-shadow: 0 0 0 3px rgba(99,102,241,.07);
        outline: none;
    }

    /* =========================================================
       CODEMIRROR
    ========================================================= */

    .CodeMirror {
        height: 100% !important;

        font-family:
            "Fira Code",
            "Cascadia Code",
            "Consolas",
            monospace;

        font-size: 13px;

        background: #090c14 !important;
        color: #f8f8f2 !important;
    }

    .cm-s-dracula.CodeMirror {
        background: #090c14 !important;
    }

    .cm-s-dracula .CodeMirror-gutters {
        background: #080b12 !important;
        border-right: 1px solid #171d2a !important;
    }

    .cm-s-dracula .CodeMirror-linenumber {
        color: #46516a !important;
    }

    .cm-s-dracula .CodeMirror-cursor {
        border-left: 2px solid #818cf8 !important;
    }

    .cm-s-dracula .CodeMirror-selected {
        background: rgba(99,102,241,.2) !important;
    }

    /* =========================================================
       TOAST NOTIFICATIONS
    ========================================================= */

    #toastContainer {
        position: fixed;
        top: 85px;
        left: 20px;

        z-index: 50000;

        display: flex;
        flex-direction: column;
        gap: 10px;

        width: min(370px,calc(100vw - 30px));

        pointer-events: none;
    }

    .premium-toast {
        display: flex;
        align-items: flex-start;
        gap: 12px;

        padding: 13px 14px;

        background:
            linear-gradient(
                135deg,
                rgba(17,24,39,.98),
                rgba(8,11,18,.98)
            );

        border: 1px solid rgba(255,255,255,.08);
        border-radius: 13px;

        box-shadow:
            0 20px 45px rgba(0,0,0,.4),
            0 0 0 1px rgba(0,0,0,.15);

        animation: toastIn .25s ease;

        pointer-events: auto;
    }

    .premium-toast.hide {
        animation: toastOut .2s ease forwards;
    }

    .toast-icon {
        width: 34px;
        height: 34px;
        min-width: 34px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background: rgba(99,102,241,.1);
        color: #818cf8;
    }

    .premium-toast.success .toast-icon {
        background: rgba(16,185,129,.1);
        color: #34d399;
    }

    .premium-toast.error .toast-icon {
        background: rgba(239,68,68,.1);
        color: #fb7185;
    }

    .premium-toast.warning .toast-icon {
        background: rgba(245,158,11,.1);
        color: #fbbf24;
    }

    .toast-content {
        flex: 1;
    }

    .toast-title {
        color: #fff;
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 2px;
    }

    .toast-message {
        color: #8993a6;
        font-size: 11px;
        line-height: 1.5;
    }

    @keyframes toastIn {
        from {
            opacity: 0;
            transform: translateX(-15px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    @keyframes toastOut {
        to {
            opacity: 0;
            transform: translateX(-15px);
        }
    }

    /* =========================================================
       MOBILE
    ========================================================= */

    @media (max-width: 1100px) {

        .stats-grid {
            grid-template-columns: repeat(3,1fr);
        }

    }

    @media (max-width: 768px) {

        .container {
            width: 100%;
            padding-left: 12px;
            padding-right: 12px;
        }

        .navbar .container {
            min-height: 64px;
        }

        .navbar .nav-menu {
            gap: 6px !important;
        }

        .logo {
            font-size: 0;
        }

        .logo::before {
            width: 35px;
            height: 35px;
        }

        .user-info span {
            display: none;
        }

        .coins-badge {
            padding: 8px 10px;
        }

        .server-header-detail {
            margin-top: 15px;
            padding: 17px;
            align-items: flex-start;
            flex-direction: column;
        }

        .server-header-detail h1 {
            font-size: 22px;
        }

        .stats-grid {
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }

        .stat-card {
            padding: 13px;
            gap: 10px;
        }

        .stat-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
            font-size: 15px;
        }

        .stat-content h3 {
            font-size: 16px;
        }

        .stat-content p {
            font-size: 9px;
        }

        .stats-grid .stat-card:nth-child(2) {
            grid-column: span 2;
        }

        .server-tabs {
            margin: 12px 0;
        }

        .tab-btn {
            padding: 10px 13px;
            font-size: 11px;
        }

        .console-container {
            height: 600px;
            min-height: 450px;
            border-radius: 14px;
        }

        .console-header {
            align-items: stretch;
            flex-direction: column;
        }

        .console-status {
            justify-content: space-between;
        }

        .console-actions {
            width: 100%;
        }

        .console-actions .btn {
            flex: 1;
        }

        .console-input-area {
            padding: 8px;
        }

        .console-input {
            min-width: 0;
        }

        .file-table {
            font-size: 11px;
        }

        .file-table th,
        .file-table td {
            padding: 8px;
        }

        .file-table th:nth-child(3),
        .file-table td:nth-child(3) {
            display: none;
        }

        .file-name {
            max-width: 170px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .menu-dropdown {
            left: auto;
            right: 0;
        }

        .modal-box {
            width: 100%;
            height: 92vh;
            padding: 13px;
            border-radius: 15px;
        }

        .editor-status {
            gap: 10px;
        }

        #toastContainer {
            left: 10px;
            right: 10px;
            width: auto;
        }

    }

    @media (max-width: 450px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .stats-grid .stat-card:nth-child(2) {
            grid-column: span 1;
        }

        .stat-card {
            width: 100%;
        }

        .server-header-detail h1 {
            max-width: 100%;
            overflow: hidden;
        }

        #serverName {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    }


/* =========================================================
   PREMIUM BLACK / WHITE / GRAY THEME
   بدون تغيير الوظائف أو HTML
========================================================= */

:root {
    --bg: #070707;
    --bg-2: #0b0b0b;

    --panel: rgba(17,17,17,.94);
    --panel-2: #111111;
    --panel-3: #181818;

    --border: rgba(255,255,255,.08);
    --border-hover: rgba(255,255,255,.20);

    --text: #f5f5f5;
    --muted: #999999;
    --muted-2: #666666;

    --primary: #bdbdbd;
    --primary-2: #ffffff;

    --success: #d4d4d4;
    --danger: #ef4444;
    --warning: #cfcfcf;
    --info: #e5e5e5;

    --radius: 16px;
    --shadow: 0 20px 60px rgba(0,0,0,.55);
}


/* =========================================================
   BODY
========================================================= */

body {
    background:
        radial-gradient(
            circle at 10% 0%,
            rgba(255,255,255,.045),
            transparent 28%
        ),
        radial-gradient(
            circle at 90% 10%,
            rgba(255,255,255,.025),
            transparent 25%
        ),
        linear-gradient(
            135deg,
            #050505,
            #0b0b0b 50%,
            #060606
        ) !important;

    color: #f5f5f5 !important;
}


/* =========================================================
   SELECTION
========================================================= */

::selection {
    background: rgba(255,255,255,.18) !important;
    color: #ffffff !important;
}


/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar-track {
    background: #070707 !important;
}

::-webkit-scrollbar-thumb {
    background: linear-gradient(
        #555555,
        #222222
    ) !important;

    border-radius: 20px;
}

::-webkit-scrollbar-thumb:hover {
    background: #777777 !important;
}


/* =========================================================
   NAVBAR
========================================================= */

.navbar {
    background: rgba(7,7,7,.90) !important;
    border-bottom: 1px solid rgba(255,255,255,.08) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
}

.logo {
    color: #ffffff !important;
}

.logo::before {
    background: linear-gradient(
        135deg,
        #222222,
        #666666
    ) !important;

    color: #ffffff !important;

    box-shadow:
        0 8px 25px rgba(0,0,0,.45),
        inset 0 1px 0 rgba(255,255,255,.10);
}

.user-info {
    color: #eeeeee !important;
}

.avatar {
    border-color: rgba(255,255,255,.16) !important;

    box-shadow:
        0 5px 20px rgba(0,0,0,.35) !important;
}


/* =========================================================
   COINS
========================================================= */

.coins-badge {
    background: rgba(255,255,255,.045) !important;
    border: 1px solid rgba(255,255,255,.10) !important;
    color: #eeeeee !important;
}


/* =========================================================
   SERVER HEADER
========================================================= */

.server-header-detail {
    background:
        linear-gradient(
            145deg,
            rgba(35,35,35,.96),
            rgba(10,10,10,.98)
        ) !important;

    border-color: rgba(255,255,255,.09) !important;

    box-shadow:
        0 20px 60px rgba(0,0,0,.45),
        inset 0 1px 0 rgba(255,255,255,.035);
}

.server-header-detail h1 {
    color: #ffffff !important;
}

.server-header-detail h1::before {
    color: #ffffff !important;
}


/* =========================================================
   STATUS
========================================================= */

.status-running {
    background: rgba(255,255,255,.06) !important;
    border-color: rgba(255,255,255,.15) !important;
    color: #eeeeee !important;
}

.status-stopped {
    background: rgba(239,68,68,.07) !important;
    border-color: rgba(239,68,68,.17) !important;
    color: #fca5a5 !important;
}


/* =========================================================
   STAT CARDS
========================================================= */

.stat-card {
    background:
        linear-gradient(
            145deg,
            rgba(25,25,25,.96),
            rgba(9,9,9,.98)
        ) !important;

    border-color: rgba(255,255,255,.075) !important;
}

.stat-card::after {
    background: rgba(255,255,255,.025) !important;
}

.stat-card:hover {
    border-color: rgba(255,255,255,.18) !important;

    box-shadow:
        0 15px 40px rgba(0,0,0,.30) !important;
}

.stat-icon {
    background: rgba(255,255,255,.045) !important;
    border-color: rgba(255,255,255,.09) !important;
    color: #dddddd !important;

    box-shadow:
        inset 0 0 15px rgba(255,255,255,.015) !important;
}

.stat-content h3 {
    color: #ffffff !important;
}

.stat-content p {
    color: #888888 !important;
}

#serverAddress {
    color: #eeeeee !important;
}


/* =========================================================
   TABS
========================================================= */

.server-tabs {
    background: rgba(12,12,12,.88) !important;
    border-color: rgba(255,255,255,.08) !important;
}

.tab-btn {
    color: #888888 !important;
}

.tab-btn:hover {
    color: #ffffff !important;
    background: rgba(255,255,255,.035) !important;
}

.tab-btn.active {
    color: #ffffff !important;

    background:
        linear-gradient(
            135deg,
            rgba(255,255,255,.09),
            rgba(255,255,255,.025)
        ) !important;

    box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.12),
        0 5px 18px rgba(0,0,0,.20);
}

.tab-btn.active::after {
    background: #ffffff !important;

    box-shadow:
        0 0 12px rgba(255,255,255,.30) !important;
}


/* =========================================================
   BUTTONS
========================================================= */

.btn-primary {
    background:
        linear-gradient(
            135deg,
            #eeeeee,
            #aaaaaa
        ) !important;

    border: 1px solid rgba(255,255,255,.18) !important;

    color: #080808 !important;

    box-shadow:
        0 10px 28px rgba(0,0,0,.35) !important;
}

.btn-primary:hover {
    filter: brightness(1.08);
}

.btn-success {
    background:
        linear-gradient(
            135deg,
            #eeeeee,
            #aaaaaa
        ) !important;

    border: 1px solid rgba(255,255,255,.16) !important;
    color: #080808 !important;
}

.btn-secondary {
    background: #181818 !important;
    border: 1px solid rgba(255,255,255,.08) !important;
    color: #eeeeee !important;
}

.btn-info,
.btn-warning {
    background: rgba(255,255,255,.045) !important;
    color: #eeeeee !important;
    border: 1px solid rgba(255,255,255,.10) !important;
}

.btn-outline {
    background: rgba(255,255,255,.025) !important;
    border: 1px solid rgba(255,255,255,.09) !important;
    color: #dddddd !important;
}

.btn-outline:hover,
.btn-secondary:hover,
.btn-info:hover,
.btn-warning:hover {
    background: rgba(255,255,255,.07) !important;
    color: #ffffff !important;
}


/* =========================================================
   CONSOLE
========================================================= */

.console-container {
    background: #080808 !important;
    border-color: rgba(255,255,255,.08) !important;
}

.console-header {
    background:
        linear-gradient(
            180deg,
            rgba(25,25,25,.98),
            rgba(10,10,10,.98)
        ) !important;

    border-color: rgba(255,255,255,.08) !important;
}

.console-icon {
    background: rgba(255,255,255,.045) !important;
    border-color: rgba(255,255,255,.09) !important;
    color: #eeeeee !important;

    box-shadow:
        0 0 20px rgba(255,255,255,.025) !important;
}

.status-badge.running {
    color: #dddddd !important;
    background: rgba(255,255,255,.05) !important;
    border-color: rgba(255,255,255,.10) !important;
}

.status-badge.stopped {
    color: #fca5a5 !important;
    background: rgba(239,68,68,.06) !important;
    border-color: rgba(239,68,68,.12) !important;
}

.pulse-dot {
    background: #ffffff !important;
    box-shadow:
